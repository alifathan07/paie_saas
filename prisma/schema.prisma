// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                          Int             @id @default(autoincrement())
  name                        String
  adresse                     String?
  ville                       String?
  ice                         String?         @unique
  ifNumber                    String?         @unique
  rc                          String?         @unique
  numeroAffiliationCnss       String?
  smig                        Decimal?        @db.Decimal(12, 2)
  numeroAssurance             String?
  workingTimeMode             WorkingTimeMode @default(DAYS)
  standardMonthlyDays         Decimal         @default(26) @db.Decimal(8, 2)
  standardMonthlyHours        Decimal         @default(191) @db.Decimal(8, 2)
  indemniteRepresentationRate Decimal         @default(0.10) @db.Decimal(6, 4)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  userCompanies       UserCompany[]
  employees           Employee[]
  employeeCategories  EmployeeCategory[]
  employeeFunctions   EmployeeFunction[]
  bonuses             Bonus[]
  rubriqueBases       RubriqueBase[]
  rubriqueRetenus     RubriqueRetenu[]
  rubriquesImposables RubriqueImposable[]
  reports             Report[]
  auditLogs           AuditLog[]

  @@map("company")
}

model Users {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isAdmin      Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  blockReason  String?
  maxCompanies Int      @default(1)

  userCompanies UserCompany[]
  reports       Report[]
  auditLogs     AuditLog[]    @relation("AuditActor")

  @@map("users")
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  SOLVED
  CLOSED
}

enum WorkingTimeMode {
  DAYS
  HOURS
}

model Report {
  id        Int          @id @default(autoincrement())
  subject   String
  message   String       @db.Text
  adminNote String?      @db.Text
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  solvedAt  DateTime?
  userId    Int
  companyId Int?
  user      Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("reports")
}

model UserCompany {
  companyId Int
  userId    Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    Users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@unique([companyId])
  @@map("userCompanies")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int
  action      String   @db.VarChar(64)
  targetType  String   @db.VarChar(64)
  targetId    Int?
  companyId   Int?
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  actor   Users    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

enum Sexe {
  M
  F
}

enum SituationFamiliale {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
}

enum NatureEmploi {
  PERMANENT
  OCCASIONNEL
  STAGIAIRE
  EXONERE
  DOCTORANT
}

enum ModePaiement {
  VIREMENT
  CHEQUE
  ESPECE // keep only if you actually have clients paying cash — otherwise drop it
}

model Employee {
  id            Int      @id @default(autoincrement())
  matricule     String
  nomComplet    String
  cin           String   @unique
  dateNaissance DateTime
  sexe          Sexe

  // --- Employment ---
  dateEmbauche      DateTime // Dte Embauche
  dateAnciennete    DateTime? // Dte Ancienneté — separate from hire date (rehires, transferred seniority)
  dateSortie        DateTime? // Date Sortie
  functionId        Int?
  employeeFunction  EmployeeFunction? @relation(fields: [functionId], references: [id])
  codeService       String? // Code Service (department/cost center)
  categoryId        Int
  category          EmployeeCategory  @relation(fields: [categoryId], references: [id])
  natureEmploi      NatureEmploi      @default(PERMANENT) // gates CNSS/AMO logic — stagiaire/exonere ≠ same contributions
  contratDateDebut  DateTime? // Contrat Du
  contratDateFin    DateTime? // Contrat Au (nullable = CDI)
  blocageSaisiePaie Boolean           @default(false) // locks employee out of active payroll run

  // --- État civil ---
  situationFam        SituationFamiliale
  nbPersonacharge     Int                @default(0) // manually updated by RH when a child ages out or new child added
  nbEnfantCharge      Int                @default(0) // manually updated by RH when a child ages out or new child added
  // ⚠️ still flagging this: keep these two in sync manually for now, but
  // build a validation rule so nbPersonacharge is never < nbEnfantCharge, and
  // never > 6 (legal IR cap). Migrate to a derived EmployeeDependent table
  // once you have real clients — see earlier discussion.
  // --- Contact ---
  adresse             String?
  ville               String? // Ville
  numeroCNSS          String?            @unique
  dateAffiliationCnss DateTime? // Dte Affiliat. under Caisse Retraite/CNSS block

  // --- Banque ---
  modePaiement ModePaiement @default(VIREMENT)
  banque       String?
  agence       String?
  rib          String?      @unique

  actif                       Boolean         @default(true)
  indemniteRepresentationName String?
  indemniteRepresentationRate Decimal?        @db.Decimal(6, 4)
  bulletinMasque              Boolean         @default(false)
  cimrRate                    Decimal?        @db.Decimal(6, 4)
  cimrReduitBaseImposable     Boolean         @default(false)
  bonuses                     EmployeeBonus[]
  payslips                    Payslip[]
  bulletinMasks               BulletinMask[]
  baseSalary                  Decimal         @db.Decimal(12, 2)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  company                     Company         @relation(fields: [companyId], references: [id])
  companyId                   Int

  @@unique([companyId, matricule])
  @@index([categoryId])
  @@index([functionId])
}

model EmployeeCategory {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("employee_categories")
}

model EmployeeFunction {
  id        Int      @id @default(autoincrement())
  name      String
  code      String
  companyId Int
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("employee_functions")
}

model Bonus {
  id            Int      @id @default(autoincrement())
  companyId     Int
  code          String   @default("") @db.VarChar(64)
  name          String
  defaultAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxable       Boolean  @default(false)
  createdAt     DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeBonuses EmployeeBonus[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("bonuses")
}

model EmployeeBonus {
  employeeId Int
  bonusId    Int
  amount     Decimal @db.Decimal(12, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bonus    Bonus    @relation(fields: [bonusId], references: [id], onDelete: Cascade)

  @@id([employeeId, bonusId])
  @@map("employee_bonuses")
}

// ================================
// PAYSLIP / BULLETIN DE PAIE
// ================================

model Payslip {
  id                   Int              @id @default(autoincrement())
  employeeId           Int
  month                Int // 1 - 12 (Count)
  year                 Int // e.g. 2026 (Count)
  workedDays           Decimal          @default(26) @db.Decimal(8, 2) // Historical day-equivalent
  workedHours          Decimal?         @db.Decimal(8, 2)
  workingTimeMode      WorkingTimeMode?
  standardMonthlyDays  Decimal?         @db.Decimal(8, 2)
  standardMonthlyHours Decimal?         @db.Decimal(8, 2)
  status               String           @default("DRAFT") // DRAFT, GENERATED, VALIDATED, CLOSED, ERROR
  validatedAt          DateTime?
  validatedById        Int?

  // Money amounts: Decimal(12, 2)
  baseSalary       Decimal @db.Decimal(12, 2)
  primeAnciennete  Decimal @default(0.00) @db.Decimal(12, 2)
  bonusesIMP       Decimal @default(0.00) @db.Decimal(12, 2)
  bonusesNIMP      Decimal @default(0.00) @db.Decimal(12, 2)
  sbg              Decimal @db.Decimal(12, 2) // Salaire Brut Global
  sbi              Decimal @db.Decimal(12, 2) // Salaire Brut Imposable
  cnss             Decimal @db.Decimal(12, 2) // CNSS Salariale
  amo              Decimal @db.Decimal(12, 2) // AMO Salariale
  cimr             Decimal @default(0.00) @db.Decimal(12, 2) // CIMR Salariale
  fraisPro         Decimal @db.Decimal(12, 2) // Frais Professionnels
  sni              Decimal @db.Decimal(12, 2) // Salaire Net Imposable
  sniCumule        Decimal @default(0.00) @db.Decimal(14, 2)
  moisEcoules      Int     @default(1) // Période sauvegardée : bulletins antérieurs validés/clôturés de l'année + bulletin courant
  sniAnnuelEstime  Decimal @default(0.00) @db.Decimal(14, 2) // SNI annuel estimé
  irAnnuelEstime   Decimal @default(0.00) @db.Decimal(14, 2) // IR annuel estimé
  irCumule         Decimal @default(0.00) @db.Decimal(14, 2) // IR cumulé dû jusqu'au mois courant
  irPrecedent      Decimal @default(0.00) @db.Decimal(14, 2) // IR déjà retenu avant le mois courant
  irNet            Decimal @default(0.00) @db.Decimal(12, 2)
  irBrut           Decimal @db.Decimal(12, 2) // IR Brut (après barème)
  irTheorique      Decimal @default(0.00) @db.Decimal(12, 2) // IR Théorique = SNI × taux
  sommeADeduire    Decimal @default(0.00) @db.Decimal(12, 2) // Somme à déduire du barème
  chargesDeFamille Decimal @default(0.00) @db.Decimal(12, 2) // Charges de famille
  netAPayer        Decimal @db.Decimal(12, 2) // Net à payer

  absenceDays      Int     @default(0)
  absenceDeduction Decimal @default(0.00) @db.Decimal(12, 2)
  heuresSup25      Decimal @default(0.00) @db.Decimal(8, 2)
  heuresSup50      Decimal @default(0.00) @db.Decimal(8, 2)
  heuresSup100     Decimal @default(0.00) @db.Decimal(8, 2)
  avances          Decimal @default(0.00) @db.Decimal(12, 2)

  // Rates / Percentages: Decimal(6, 4)
  cnssRate     Decimal? @db.Decimal(6, 4) // e.g. 0.0448
  amoRate      Decimal? @db.Decimal(6, 4) // e.g. 0.0226
  cimrRate     Decimal? @db.Decimal(6, 4) // e.g. 0.0300, 0.0600
  fraisProRate Decimal? @db.Decimal(6, 4) // e.g. 0.2500 / 0.3500
  irRate       Decimal? @db.Decimal(6, 4) // e.g. 0.1000, 0.2000, 0.3000...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bonuses  PayslipBonus[]
  retenus  PayslipRetenu[]

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@map("payslips")
}

model BulletinMask {
  id         Int      @id @default(autoincrement())
  employeeId Int
  month      Int
  year       Int
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@map("bulletin_masks")
}

// ================================
// PAYSLIP BONUS / LIGNES PRIMES DU BULLETIN
// ================================

model PayslipBonus {
  id                  Int      @id @default(autoincrement())
  payslipId           Int
  rubriqueImposableId Int?
  name                String
  code                String   @default("") @db.VarChar(64)
  amount              Decimal  @db.Decimal(12, 2)
  baseAmount          Decimal? @db.Decimal(12, 2) // Full-month source amount for prorated non-taxable indemnities
  taxable             Boolean  @default(true) // true = Imposable, false = Non-imposable / Exonéré
  createdAt           DateTime @default(now())

  payslip           Payslip            @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  rubriqueImposable RubriqueImposable? @relation(fields: [rubriqueImposableId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@index([rubriqueImposableId])
  @@map("payslip_bonuses")
}

// ================================
// PAYROLL CONFIGURATION (OPTIONAL DYNAMIC RATES)
// ================================

model PayrollConfig {
  id                       Int     @id @default(autoincrement())
  cnssSalarialeRate        Decimal @default(0.0448) @db.Decimal(6, 4) // 4.48%
  cnssPlafond              Decimal @default(6000.00) @db.Decimal(12, 2) // 6000 DH
  amoSalarialeRate         Decimal @default(0.0226) @db.Decimal(6, 4) // 2.26%
  fraisProStandardRate     Decimal @default(0.3500) @db.Decimal(6, 4) // 35%
  fraisProHighRate         Decimal @default(0.2500) @db.Decimal(6, 4) // 25%
  fraisProStandardCap      Decimal @default(2500.00) @db.Decimal(12, 2) // 2500 DH
  fraisProHighCap          Decimal @default(2916.67) @db.Decimal(12, 2) // 2916.67 DH
  chargeFamilleParPersonne Decimal @default(50.00) @db.Decimal(12, 2) // 50 DH/person
  maxChargesFamilleCount   Int     @default(6) // Max 6 dependents (300 DH cap)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_configs")
}

model RubriqueBase {
  id        Int      @id @default(autoincrement())
  companyId Int
  key       String   @db.VarChar(64)
  name      String   @db.VarChar(191)
  code      String   @db.VarChar(64)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("rubrique_base")
}

model RubriqueRetenu {
  id        Int      @id @default(autoincrement())
  companyId Int
  key       String   @db.VarChar(64)
  name      String   @db.VarChar(191)
  code      String   @db.VarChar(64)
  entryType String   @default("SYSTEM") @db.VarChar(16)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslipRetenus PayslipRetenu[]

  @@unique([companyId, key])
  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("rubrique_retenu")
}

model PayslipRetenu {
  id               Int      @id @default(autoincrement())
  payslipId        Int
  rubriqueRetenuId Int
  code             String   @db.VarChar(64)
  name             String   @db.VarChar(191)
  amount           Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  payslip        Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  rubriqueRetenu RubriqueRetenu @relation(fields: [rubriqueRetenuId], references: [id], onDelete: Restrict)

  @@index([payslipId])
  @@index([rubriqueRetenuId])
  @@map("payslip_retenus")
}

model RubriqueImposable {
  id             Int      @id @default(autoincrement())
  companyId      Int
  code           String   @db.VarChar(64)
  name           String   @db.VarChar(191)
  entryType      String   @default("MANUAL_AMOUNT") @db.VarChar(32)
  calculationKey String?  @db.VarChar(64)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslipBonuses PayslipBonus[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("rubrique_imposable")
}

// Legacy tables remain mapped so existing migrations/data are not silently dropped.
model LegacyBulletinRubrique {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(191)
  code String @db.VarChar(64)

  @@map("bulletin_rubrique")
}

model LegacyRubriqueImposable {
  id     Int     @id @default(autoincrement())
  code   String  @db.VarChar(64)
  name   String  @db.VarChar(191)
  amount Decimal @db.Decimal(12, 2)

  @@map("rubrique_imposable_legacy")
}
