<%- include('../partials/header') %>
<% if (reportType === 'cnss') { %><style>.contributions-cnss-only section.contribution-report:nth-of-type(n+4){display:none}</style><div class="contributions-cnss-only"><% } else if (reportType === 'amo') { %><style>.contributions-amo-only section.contribution-report:nth-of-type(2),.contributions-amo-only section.contribution-report:nth-of-type(3){display:none}.contributions-amo-only section.contribution-report:nth-of-type(4) .contribution-table th:nth-child(9),.contributions-amo-only section.contribution-report:nth-of-type(4) .contribution-table td:nth-child(9),.contributions-amo-only section.contribution-report:nth-of-type(4) .contribution-table .contribution-total th:nth-child(6){display:none}</style><div class="contributions-amo-only"><% } else { %><div><% } %>
<div class="page-header editions-header"><div class="header-title-area"><h1 class="page-title"><%= reportType === 'cnss' ? 'État mensuel CNSS' : reportType === 'amo' ? 'État mensuel AMO' : 'États mensuels CNSS / AMO' %></h1><p class="page-subtitle"><%= report.company.name %> · données des bulletins de <%= monthName %> <%= year %></p></div></div>
<% if (error) { %><div class="bulk-summary editions-error" role="alert"><%= error %></div><% } %>
<section class="edition-form-card"><form method="GET" action="<%= reportType === 'cnss' ? '/editions/cnss' : reportType === 'amo' ? '/editions/amo' : '/editions/contributions' %>" class="bulletin-export-form"><div class="bulletin-export-grid"><label><span>Mois</span><select class="form-input" name="month"><% for (let m = 1; m <= 12; m++) { %><option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= monthNames[m] %></option><% } %></select></label><label><span>Année</span><input class="form-input" type="number" name="year" min="2020" max="2040" value="<%= year %>"></label></div><div class="edition-form-actions"><button class="btn-primary" type="submit">Afficher</button><% if (reportType !== 'amo') { %><a class="button secondary" href="/editions/cnss/pdf?month=<%= month %>&year=<%= year %>">Télécharger le PDF CNSS</a><% } %><% if (reportType !== 'cnss') { %><a class="button secondary" href="/editions/amo/pdf?month=<%= month %>&year=<%= year %>">Télécharger l'État AMO</a><% } %></div></form></section>
<% if (report.rows.length) { %>
<section class="contribution-report"><h2>ÉTAT CNSS <%= String(month).padStart(2, '0') %>/<%= String(year).slice(-2) %></h2><p>N°CNSS : <strong><%= report.company.numeroAffiliationCnss %></strong> · Total effectif : <strong><%= report.cnssTotals.effectif %></strong></p><div class="contribution-table-wrap"><table class="contribution-table"><thead><tr><th>MLE</th><th>NOM &amp; PRENOM</th><th>CIN</th><th>N° CNSS</th><th>JOURS</th><th>JR CG</th><th>T. JRS</th><th>SANS LIMITE PLAFONNE</th><th>DANS LIMITE PLAFONNE</th><th>RETENU SAL. 4.48%</th><th>ALLOC. FAM. 6.40%</th><th>PREST. PAT. 8.98%</th><th>FORMAT. PROF. 1.60%</th><th>COTIS.TOT.</th></tr></thead><tbody><% report.rows.forEach(row => { %><tr><td><%= row.matricule %></td><td><%= row.nomPrenom %></td><td><%= row.cin %></td><td><%= row.numeroCNSS %></td><td><%= fmt(row.jours) %></td><td><%= row.jrCg ? fmt(row.jrCg) : '' %></td><td><%= fmt(row.totalJours) %></td><td><%= fmt(row.sansLimitePlafonne) %></td><td><%= fmt(row.dansLimitePlafonne) %></td><td><%= fmt(row.retenuSal) %></td><td><%= fmt(row.allocFam) %></td><td><%= fmt(row.prestations) %></td><td><%= fmt(row.formation) %></td><td><%= fmt(row.cotisTot) %></td></tr><% }); %><tr class="contribution-total"><th colspan="4">TOTAL</th><th><%= fmt(report.cnssTotals.jours) %></th><th><%= fmt(report.cnssTotals.jrCg) %></th><th><%= fmt(report.cnssTotals.totalJours) %></th><th><%= fmt(report.cnssTotals.sansLimitePlafonne) %></th><th><%= fmt(report.cnssTotals.dansLimitePlafonne) %></th><th><%= fmt(report.cnssTotals.retenuSal) %></th><th><%= fmt(report.cnssTotals.allocFam) %></th><th><%= fmt(report.cnssTotals.prestations) %></th><th><%= fmt(report.cnssTotals.formation) %></th><th><%= fmt(report.cnssTotals.cotisTot) %></th></tr></tbody></table></div></section>
<section class="contribution-report contribution-summary"><h2>ÉTAT DES VIREMENTS CNSS <%= String(month).padStart(2, '0') %>/<%= String(year).slice(-2) %></h2><p>N°CNSS : <strong><%= report.company.numeroAffiliationCnss %></strong></p><table class="contribution-summary-table"><thead><tr><th>NATURE DES PRESTATIONS</th><th>MASSE SALARIALE</th><th>TAUX</th><th>MONTANT</th></tr></thead><tbody><tr><td>ALLOCATION FAMILIALE</td><td><%= fmt(report.cnssTotals.sansLimitePlafonne) %></td><td>6.40</td><td><%= fmt(report.transfer.allocation) %></td></tr><tr><td>PRESTATION SOCIALES</td><td><%= fmt(report.cnssTotals.dansLimitePlafonne) %></td><td>13.46</td><td><%= fmt(report.transfer.prestations) %></td></tr><tr><td>TAXE FORMATION PROF.</td><td><%= fmt(report.cnssTotals.sansLimitePlafonne) %></td><td>1.60</td><td><%= fmt(report.transfer.formation) %></td></tr><tr class="contribution-total"><th colspan="3">TOTAL</th><th><%= fmt(report.transfer.total) %></th></tr></tbody></table><p class="contribution-totals">COTISATIONS SALARIALES : <strong><%= fmt(report.transfer.salariales) %></strong><br>COTISATIONS PATRONALES : <strong><%= fmt(report.transfer.patronales) %></strong><br>TOTAL : <strong><%= fmt(report.transfer.total) %></strong></p></section>
<section class="contribution-report"><h2>ÉTAT AMO <%= String(month).padStart(2, '0') %>/<%= String(year).slice(-2) %></h2><p>N°CNSS : <strong><%= report.company.numeroAffiliationCnss %></strong> · Total effectif : <strong><%= report.amoTotals.effectif || report.cnssTotals.effectif %></strong></p><div class="contribution-table-wrap"><table class="contribution-table"><thead><tr><th>MLE</th><th>NOM &amp; PRENOM</th><th>CIN</th><th>N° CNSS</th><th>JOURS</th><th>JR CG</th><th>T. JRS</th><th>SANS LIMITE<br>PLAFONNE</th><th>DANS LIMITE<br>PLAFONNE</th><th>PARTICIPATION AMO<br>PAR PERSONNE</th><th>COTISATIONS<br>SALARIALES</th><th>COTISATIONS<br>PATRONALES</th><th>COTIS.TOT.</th></tr></thead><tbody><% report.rows.forEach(row => { %><tr><td><%= row.matricule %></td><td><%= row.nomPrenom %></td><td><%= row.cin %></td><td><%= row.numeroCNSS %></td><td><%= fmt(row.jours) %></td><td><%= row.jrCg ? fmt(row.jrCg) : '' %></td><td><%= fmt(row.totalJours) %></td><td><%= fmt(row.sansLimitePlafonne) %></td><td><%= fmt(row.dansLimitePlafonne) %></td><td><%= fmt(row.amoParticipation) %></td><td><%= fmt(row.amoSalariale) %></td><td><%= fmt(row.amoPatronale) %></td><td><%= fmt(row.amoCotisTot) %></td></tr><% }); %><tr class="contribution-total"><th colspan="4">TOTAL</th><th><%= fmt(report.cnssTotals.jours) %></th><th><%= fmt(report.cnssTotals.jrCg) %></th><th><%= fmt(report.cnssTotals.totalJours) %></th><th><%= fmt(report.amoTotals.masse) %></th><th><%= fmt(report.cnssTotals.dansLimitePlafonne) %></th><th><%= fmt(report.amoTotals.participation) %></th><th><%= fmt(report.amoTotals.salariales) %></th><th><%= fmt(report.amoTotals.patronales) %></th><th><%= fmt(report.amoTotals.cotisTot) %></th></tr></tbody></table></div></section><section class="contribution-report contribution-summary"><h2>RÉCAPITULATIF AMO</h2><table class="contribution-summary-table"><thead><tr><th>NATURE</th><th>MASSE SALARIALE</th><th>TAUX</th><th>MONTANT</th></tr></thead><tbody><tr><td>PARTICIPATION AMO</td><td><%= fmt(report.amoTotals.masse) %></td><td>1.85 %</td><td><%= fmt(report.amoTotals.participation) %></td></tr><tr><td>COTISATIONS SALARIALES</td><td><%= fmt(report.amoTotals.masse) %></td><td>2.2600 %</td><td><%= fmt(report.amoTotals.salariales) %></td></tr><tr><td>COTISATIONS PATRONALES</td><td><%= fmt(report.amoTotals.masse) %></td><td>4.1100 %</td><td><%= fmt(report.amoTotals.patronales) %></td></tr><tr class="contribution-total"><th colspan="3">TOTAL COTISATIONS</th><th><%= fmt(report.amoTotals.cotisTot) %></th></tr></tbody></table></section>
<% } %></div><%- include('../partials/footer') %>
