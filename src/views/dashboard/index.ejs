<%- include('../partials/header') %>

<% if (companySetupRequired) { %>
<style>.company-setup-reminder{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(17,29,59,.46);backdrop-filter:blur(4px)}.company-setup-reminder-card{width:min(500px,100%);padding:32px;border:1px solid #e1e7f0;border-radius:18px;background:#fff;box-shadow:0 25px 80px rgba(23,38,75,.25)}.company-setup-reminder-badge{display:inline-flex;padding:7px 10px;border-radius:999px;background:#fff5dc;color:#a66a00;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.company-setup-reminder-card h2{margin:18px 0 10px;color:#17264b;font-size:26px;letter-spacing:-.7px}.company-setup-reminder-card p{margin:0;color:#71809a;font-size:14px;line-height:1.65}.company-setup-reminder-actions{display:flex;align-items:center;gap:14px;margin-top:26px}.company-setup-reminder-go{display:inline-flex;justify-content:center;flex:1;padding:13px 18px;border-radius:9px;background:#3158c9;color:#fff;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 8px 18px rgba(49,88,201,.2)}.company-setup-reminder-later{border:0;background:none;color:#71809a;font:inherit;font-size:12px;cursor:pointer}.company-setup-reminder-go:hover{background:#2749ad}@media(max-width:520px){.company-setup-reminder-card{padding:25px}.company-setup-reminder-actions{display:grid;gap:10px}.company-setup-reminder-later{padding:8px}}</style>
<div class="company-setup-reminder" id="company-setup-reminder" role="dialog" aria-modal="true" aria-labelledby="company-setup-reminder-title"><div class="company-setup-reminder-card"><span class="company-setup-reminder-badge">Configuration incomplète</span><h2 id="company-setup-reminder-title">Complétez les informations de votre entreprise</h2><p>Ajoutez votre adresse, ville, IF, CNSS et SMIG pour éviter des erreurs dans vos bulletins, PDF et déclarations.</p><div class="company-setup-reminder-actions"><a class="company-setup-reminder-go" href="/parametrage">Aller au paramétrage</a><button class="company-setup-reminder-later" type="button" onclick="document.getElementById('company-setup-reminder').remove()">Plus tard</button></div></div></div>
<% } %>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">Vue d'ensemble de la masse salariale et gestion des effectifs RH</p>
    </div>
    <div class="header-actions">
        <a href="/employees/create" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Ajouter un employé
        </a>
    </div>
</div>

<!-- KPI Cards Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Employés</div>
        <div class="stat-value"><%= stats ? stats.totalEmployees : 0 %></div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            <%= stats ? stats.activeEmployees : 0 %> actifs
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Masse Salariale de Base</div>
        <div class="stat-value"><%= stats ? Number(stats.totalSalaryMass).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) : '0,00' %> DH</div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            Cumul salaires bruts de base
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Salaire Moyen</div>
        <div class="stat-value"><%= stats ? Number(stats.avgSalary).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) : '0,00' %> DH</div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            Par employé actif
        </div>
    </div>
</div>

<!-- Recent Employees Section -->
<div class="card" style="margin-top: 24px;">
    <div class="card-header">
        <h2 class="card-title">Derniers employés enregistrés</h2>
        <a href="/employees" class="table-link">Voir tous les employés →</a>
    </div>

    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Matricule</th>
                    <th>Nom & Prénom</th>
                    <th>Poste</th>
                    <th>CIN</th>
                    <th>Salaire de base</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (stats && stats.recentEmployees && stats.recentEmployees.length > 0) { %>
                    <% stats.recentEmployees.forEach(function(emp) { %>
                        <tr>
                            <td style="font-weight: 600;"><%= emp.matricule %></td>
                            <td style="font-weight: 600;"><%= emp.nomComplet %></td>
                            <td><%= emp.employeeFunction ? emp.employeeFunction.name : 'Non renseigné' %></td>
                            <td><%= emp.cin %></td>
                            <td style="font-weight: 600;"><%= Number(emp.baseSalary).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) %> DH</td>
                            <td>
                                <span class="badge <%= emp.blocageSaisiePaie ? 'badge-draft' : 'badge-actif' %>">
                                    <%= emp.blocageSaisiePaie ? 'Bloqué' : 'Actif' %>
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a href="/employees/<%= emp.id %>" class="table-link">Détails</a>
                                    <a href="/employees/<%= emp.id %>/edit" class="table-link" style="color: var(--color-text-subtle);">Éditer</a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="table-empty">
                            Aucun employé enregistré dans la base de données.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
