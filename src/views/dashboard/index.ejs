<%- include('../partials/header') %>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">Vue d'ensemble de la masse salariale et gestion des effectifs RH</p>
    </div>
    <div class="header-actions">
        <a href="/employees/create" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Ajouter un employé
        </a>
    </div>
</div>

<!-- KPI Cards Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Employés</div>
        <div class="stat-value"><%= stats ? stats.totalEmployees : 0 %></div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            <%= stats ? stats.activeEmployees : 0 %> actifs
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Masse Salariale de Base</div>
        <div class="stat-value"><%= stats ? Number(stats.totalSalaryMass).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) : '0,00' %> DH</div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            Cumul salaires bruts de base
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Salaire Moyen</div>
        <div class="stat-value"><%= stats ? Number(stats.avgSalary).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) : '0,00' %> DH</div>
        <div style="font-size: 13px; color: var(--color-text-subtle); margin-top: 4px;">
            Par employé actif
        </div>
    </div>
</div>

<!-- Recent Employees Section -->
<div class="card" style="margin-top: 24px;">
    <div class="card-header">
        <h2 class="card-title">Derniers employés enregistrés</h2>
        <a href="/employees" class="table-link">Voir tous les employés →</a>
    </div>

    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Matricule</th>
                    <th>Nom & Prénom</th>
                    <th>Poste</th>
                    <th>CIN</th>
                    <th>Salaire de base</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (stats && stats.recentEmployees && stats.recentEmployees.length > 0) { %>
                    <% stats.recentEmployees.forEach(function(emp) { %>
                        <tr>
                            <td style="font-weight: 600;"><%= emp.matricule %></td>
                            <td style="font-weight: 600;"><%= emp.nom %> <%= emp.prenom %></td>
                            <td><%= emp.fonction || 'Non renseigné' %></td>
                            <td><%= emp.cin %></td>
                            <td style="font-weight: 600;"><%= Number(emp.baseSalary).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) %> DH</td>
                            <td>
                                <span class="badge <%= emp.actif ? 'badge-actif' : 'badge-draft' %>">
                                    <%= emp.actif ? 'Actif' : 'Inactif' %>
                                </span>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a href="/employees/<%= emp.id %>" class="table-link">Détails</a>
                                    <a href="/employees/<%= emp.id %>/edit" class="table-link" style="color: var(--color-text-subtle);">Éditer</a>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="table-empty">
                            Aucun employé enregistré dans la base de données.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
