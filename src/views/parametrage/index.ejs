<%- include('../partials/header') %>
<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Paramétrage</h1>
        <p class="page-subtitle">Modifiez les informations de la société actuellement sélectionnée.</p>
    </div>
</div>

<section class="card company-settings-card">
    <div class="card-header"><h2 class="card-title">Informations de la société</h2></div>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
    <form method="POST" action="/parametrage" class="company-settings-form">
        <div class="settings-form-grid">
            <label class="form-label settings-wide">Raison sociale<input class="form-input" name="name" maxlength="191" required value="<%= form.name %>"></label>
            <label class="form-label settings-wide">Adresse<input class="form-input" name="adresse" maxlength="191" required value="<%= form.adresse %>"></label>
            <label class="form-label">Ville<input class="form-input" name="ville" maxlength="191" required value="<%= form.ville %>"></label>
            <label class="form-label">IF<input class="form-input" name="ifNumber" maxlength="191" required value="<%= form.ifNumber %>"></label>
            <label class="form-label">N° affiliation CNSS<input class="form-input" name="numeroAffiliationCnss" maxlength="191" required value="<%= form.numeroAffiliationCnss %>"></label>
            <label class="form-label">SMIG pour 26 jours<input class="form-input" type="number" name="smig" min="0.01" step="0.01" required value="<%= form.smig %>"></label>
            <label class="form-label">ICE <span>(optionnel)</span><input class="form-input" name="ice" maxlength="191" value="<%= form.ice %>"></label>
            <label class="form-label">RC <span>(optionnel)</span><input class="form-input" name="rc" maxlength="191" value="<%= form.rc %>"></label>
            <label class="form-label">N° assurance <span>(optionnel)</span><input class="form-input" name="numeroAssurance" maxlength="191" value="<%= form.numeroAssurance %>"></label>
        </div>
        <div class="settings-form-actions"><button class="btn-primary" type="submit">Enregistrer les modifications</button></div>
    </form>
</section>
<%- include('../partials/footer') %>
