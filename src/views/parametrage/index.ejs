<%- include('../partials/header') %>
<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Paramétrage</h1>
        <p class="page-subtitle">Modifiez les informations de la société actuellement sélectionnée.</p>
    </div>
</div>

<section class="card company-settings-card">
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
    <form method="POST" action="/parametrage" class="company-settings-form">
        <div class="settings-section">
            <h2 class="settings-section-title">Informations de la société</h2>
            <div class="settings-form-grid">
                <label class="form-label settings-wide">Raison sociale<input class="form-input" name="name" maxlength="191" required value="<%= form.name %>"></label>
                <label class="form-label settings-wide">Adresse<input class="form-input" name="adresse" maxlength="191" required value="<%= form.adresse %>"></label>
                <label class="form-label settings-wide">Ville<input class="form-input" name="ville" maxlength="191" required value="<%= form.ville %>"></label>
            </div>
        </div>

        <div class="settings-section">
            <h2 class="settings-section-title">Identifiants de la société</h2>
            <div class="settings-form-grid">
                <label class="form-label">IF<input class="form-input" name="ifNumber" maxlength="191" required value="<%= form.ifNumber %>"></label>
                <label class="form-label">CNSS<input class="form-input" name="numeroAffiliationCnss" maxlength="191" required value="<%= form.numeroAffiliationCnss %>"></label>
                <label class="form-label">RC<input class="form-input" name="rc" maxlength="191" value="<%= form.rc %>"></label>
                <label class="form-label">ICE<input class="form-input" name="ice" maxlength="191" value="<%= form.ice %>"></label>
                <label class="form-label">N assurance<input class="form-input" name="numeroAssurance" maxlength="191" value="<%= form.numeroAssurance %>"></label>
                <label class="form-label">CIMR<input class="form-input" name="cimr" maxlength="191" value=""></label>
            </div>
        </div>

        <div class="settings-section">
            <h2 class="settings-section-title">Mode de Calcul</h2>
            <div class="settings-mode-options" role="group" aria-label="Mode de calcul">
                <label class="settings-checkbox-label">
                    <input type="checkbox" name="workingTimeMode" value="DAYS" <%= form.workingTimeMode === 'DAYS' ? 'checked' : '' %>>
                    <span>Jours</span>
                </label>
                <label class="settings-checkbox-label">
                    <input type="checkbox" name="workingTimeMode" value="HOURS" <%= form.workingTimeMode === 'HOURS' ? 'checked' : '' %>>
                    <span>Heures</span>
                </label>
            </div>
            <input type="hidden" name="standardMonthlyDays" value="<%= form.standardMonthlyDays %>">
            <input type="hidden" name="standardMonthlyHours" value="<%= form.standardMonthlyHours %>">
            <label class="form-label settings-smig">SMIG<input class="form-input" type="number" name="smig" min="0.01" step="0.01" required value="<%= form.smig %>"></label>
        </div>
    </form>
</section>
<script>
    const settingsForm = document.querySelector('.company-settings-form');
    let settingsSubmitting = false;

    const submitSettings = () => {
        if (settingsSubmitting) return;
        settingsSubmitting = true;
        settingsForm.requestSubmit();
    };

    document.querySelectorAll('.settings-mode-options input[type="checkbox"]').forEach((checkbox) => {
        checkbox.addEventListener('change', () => {
            if (!checkbox.checked) return;
            document.querySelectorAll('.settings-mode-options input[type="checkbox"]').forEach((other) => {
                if (other !== checkbox) other.checked = false;
            });
        });
    });

    // Enter always saves the form, including when focus is on a checkbox.
    settingsForm.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            submitSettings();
            return;
        }

        if (event.key === 'Tab' && !event.shiftKey) {
            const focusableFields = [...settingsForm.querySelectorAll('input:not([type="hidden"]), select, textarea, button')]
                .filter((field) => !field.disabled);
            if (event.target === focusableFields.at(-1)) submitSettings();
        }
    });

    // Leaving the form also saves the changes when focus moves outside it.
    settingsForm.addEventListener('focusout', (event) => {
        window.setTimeout(() => {
            if (!settingsForm.contains(document.activeElement)) submitSettings();
        }, 0);
    });
</script>
<%- include('../partials/footer') %>
