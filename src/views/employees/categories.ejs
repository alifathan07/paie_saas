<%- include('../partials/header') %>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Catégories des employés</h1>
        <p class="page-subtitle">Créez les catégories disponibles dans les fiches employés.</p>
    </div>
    <div class="header-actions"><a href="/employees" class="btn-secondary">Retour aux employés</a></div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<section class="catalog-create-card">
    <div class="catalog-create-copy"><span class="catalog-create-icon">+</span><div><h2>Ajouter une catégorie</h2><p>Elle pourra ensuite être sélectionnée lors de la création ou modification d’un employé.</p></div></div>
    <form action="/employees/categories" method="POST" class="catalog-create-form">
        <label class="sr-only" for="category-name">Nom de la catégorie</label>
        <input id="category-name" name="name" class="form-input" required maxlength="191" placeholder="Ex. Cadre, Employé, Stagiaire">
        <button class="btn-primary" type="submit">Ajouter</button>
    </form>
</section>

<section class="catalog-card">
    <div class="catalog-card-header"><div><h2>Catégories disponibles</h2><p>Les catégories utilisées par vos employés.</p></div><span class="catalog-count"><%= categories.length %> <%= categories.length === 1 ? 'catégorie' : 'catégories' %></span></div>
    <% if (categories.length) { %>
        <div class="data-table-wrapper catalog-table-wrapper"><table class="data-table catalog-table"><thead><tr><th>Nom</th><th>Employés affectés</th><th>Actions</th></tr></thead><tbody>
            <% categories.forEach(function(category) { %><tr>
                <td><form id="edit-category-<%= category.id %>" action="/employees/categories/<%= category.id %>/edit" method="POST"></form><input form="edit-category-<%= category.id %>" class="form-input catalog-name-input" name="name" value="<%= category.name %>" required maxlength="191"></td>
                <td><%= category._count.employees %> <%= category._count.employees === 1 ? 'employé' : 'employés' %></td>
                <td class="catalog-actions"><button class="btn-secondary btn-compact" form="edit-category-<%= category.id %>" type="submit">Enregistrer</button><form id="delete-category-<%= category.id %>" action="/employees/categories/<%= category.id %>/delete" method="POST"></form><button class="btn-icon-delete btn-compact" type="submit" form="delete-category-<%= category.id %>" data-confirm="Supprimer cette catégorie ? Elle doit être vide pour être supprimée." data-confirm-title="Supprimer la catégorie" data-confirm-label="Supprimer" data-confirm-danger="true">Supprimer</button></td>
            </tr><% }); %>
        </tbody></table></div>
    <% } else { %><div class="catalog-empty-state"><h3>Aucune catégorie</h3><p>Ajoutez votre première catégorie ci-dessus.</p></div><% } %>
</section>

<%- include('../partials/footer') %>
