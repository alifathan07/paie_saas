<%- include('../partials/header') %>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Banques</h1>
        <p class="page-subtitle">Gérez les banques disponibles dans les fiches employés.</p>
    </div>
    <div class="header-actions"><a href="/employees" class="btn-secondary">Retour aux employés</a></div>
</div>

<% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

<section class="catalog-create-card">
    <div class="catalog-create-copy"><span class="catalog-create-icon">+</span><div><h2>Ajouter une banque</h2><p>Elle apparaîtra ensuite dans la sélection des fiches employés.</p></div></div>
    <form action="/employees/banques" method="POST" class="catalog-create-form">
        <label class="sr-only" for="banque-name">Nom de la banque</label>
        <input id="banque-name" name="name" class="form-input" required maxlength="191" placeholder="Ex. Attijariwafa Bank">
        <button class="btn-primary" type="submit">Ajouter</button>
    </form>
</section>

<section class="catalog-card">
    <div class="catalog-card-header"><div><h2>Banques disponibles</h2><p>Les banques proposées dans les formulaires employés.</p></div><span class="catalog-count"><%= banques.length %> <%= banques.length === 1 ? 'banque' : 'banques' %></span></div>
    <% if (banques.length) { %>
        <div class="data-table-wrapper catalog-table-wrapper"><table class="data-table catalog-table"><thead><tr><th>Nom</th><th>Employés affectés</th><th>Actions</th></tr></thead><tbody>
            <% banques.forEach(function(banque) { %><tr>
                <td><form id="edit-banque-<%= banque.id %>" action="/employees/banques/<%= banque.id %>/edit" method="POST"></form><input form="edit-banque-<%= banque.id %>" class="form-input catalog-name-input" name="name" value="<%= banque.name %>" required maxlength="191"></td>
                <td><%= banque.employeesCount %> <%= banque.employeesCount === 1 ? 'employé' : 'employés' %></td>
                <td class="catalog-actions"><button class="btn-secondary btn-compact" form="edit-banque-<%= banque.id %>" type="submit">Enregistrer</button><form id="delete-banque-<%= banque.id %>" action="/employees/banques/<%= banque.id %>/delete" method="POST"></form><button class="btn-icon-delete btn-compact" type="submit" form="delete-banque-<%= banque.id %>" data-confirm="Supprimer cette banque ? Elle doit être inutilisée pour être supprimée." data-confirm-title="Supprimer la banque" data-confirm-label="Supprimer" data-confirm-danger="true">Supprimer</button></td>
            </tr><% }); %>
        </tbody></table></div>
    <% } else { %><div class="catalog-empty-state"><h3>Aucune banque</h3><p>Ajoutez votre première banque ci-dessus.</p></div><% } %>
</section>

<%- include('../partials/footer') %>
