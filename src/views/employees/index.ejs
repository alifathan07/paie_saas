<%- include('../partials/header') %>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Gestion des Salariés</h1>
        <p class="page-subtitle">Liste et administration des employés de l'entreprise</p>
    </div>
    <div class="header-actions">
        <a href="/employees/create" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nouveau Salarié
        </a>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
<% } %>

<!-- Filter Bar -->
<div class="card" style="margin-bottom: 24px; padding: 20px 24px;">
    <form method="GET" action="/employees" style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
            <input type="text" name="search" class="form-input" placeholder="Rechercher par nom, prénom, CIN, matricule..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </div>
        <div style="width: 200px;">
            <select name="statut" class="form-input">
                <option value="">Tous les statuts</option>
                <option value="TITULAIRE" <%= typeof statut !== 'undefined' && statut === 'TITULAIRE' ? 'selected' : '' %>>Titulaire</option>
                <option value="NON_TITULAIRE" <%= typeof statut !== 'undefined' && statut === 'NON_TITULAIRE' ? 'selected' : '' %>>Non Titulaire</option>
                <option value="VACATAIRE" <%= typeof statut !== 'undefined' && statut === 'VACATAIRE' ? 'selected' : '' %>>Vacataire</option>
            </select>
        </div>
        <button type="submit" class="btn-secondary">
            Filtrer
        </button>
        <% if ((typeof search !== 'undefined' && search) || (typeof statut !== 'undefined' && statut)) { %>
            <a href="/employees" class="table-link" style="font-size: 14px; margin-left: 8px;">Réinitialiser</a>
        <% } %>
    </form>
</div>

<!-- Employees Table -->
<div class="data-table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Matricule</th>
                <th>Salarié</th>
                <th>CIN</th>
                <th>Fonction</th>
                <th>Statut</th>
                <th>Nature d'emploi</th>
                <th>Salaire de base</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees && employees.length > 0) { %>
                <% employees.forEach(function(emp) { %>
                    <tr>
                        <td style="font-weight: 600;"><%= emp.matricule %></td>
                        <td>
                            <div style="font-weight: 600;"><%= emp.nom %> <%= emp.prenom %></div>
                            <div style="font-size: 12px; color: var(--color-text-subtle);"><%= emp.numeroCNSS ? 'CNSS: ' + emp.numeroCNSS : 'Sans CNSS' %></div>
                        </td>
                        <td><%= emp.cin %></td>
                        <td><%= emp.fonction || '—' %></td>
                        <td>
                            <span class="badge <%= emp.actif ? 'badge-actif' : 'badge-draft' %>">
                                <%= emp.statut %>
                            </span>
                        </td>
                        <td><%= emp.natureEmploi %></td>
                        <td style="font-weight: 600;"><%= Number(emp.baseSalary).toLocaleString('fr-MA', { minimumFractionDigits: 2 }) %> DH</td>
                        <td>
                            <div class="table-actions">
                                <a href="/employees/<%= emp.id %>" class="table-link">Détails</a>
                                <a href="/employees/<%= emp.id %>/edit" class="table-link" style="color: var(--color-text-subtle);">Éditer</a>
                                <form action="/employees/<%= emp.id %>/delete" method="POST" style="display:inline;" data-confirm="Êtes-vous sûr de vouloir supprimer cet employé ?" data-confirm-title="Supprimer cet employé" data-confirm-label="Supprimer" data-confirm-danger="true">
                                    <button type="submit" class="btn-icon-delete">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="8" class="table-empty">
                        Aucun employé trouvé. Cliquez sur "Nouveau Salarié" pour en ajouter un.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<%- include('../partials/footer') %>
