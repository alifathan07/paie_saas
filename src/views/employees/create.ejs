<%- include('../partials/header') %>

    <div class="page-header">
        <div class="header-title-area">
            <h1 class="page-title">Créer un nouveau salarié</h1>
            <p class="page-subtitle">Renseignez la fiche individuelle et contractuelle de l'employé</p>
        </div>
        <div class="header-actions">
            <a href="/employees/import" class="btn-secondary">Importer un fichier</a>
            <a href="/employees" class="btn-secondary">Annuler</a>
        </div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-error">
            <%= error %>
        </div>
        <% } %>

            <form id="employee-create-form" action="/employees/create" method="POST" class="enterprise-form">
                <input type="hidden" name="returnTab" id="employee-return-tab" value="general">
                <nav class="employee-tabs-shell" aria-label="Sections du salarié">
                    <div class="employee-tabs-label"><span class="employee-tabs-label-icon">☰</span><div><strong>Sections de la fiche salarié</strong><small>Choisissez une section à renseigner</small></div></div>
                    <div class="employee-tabs">
                        <button type="button" class="employee-tab active" data-tab="general"><span class="employee-tab-icon">●</span><span><strong>Informations générales</strong><small>État civil, contrat et coordonnées</small></span></button>
                        <button type="button" class="employee-tab" data-tab="indemnites"><span class="employee-tab-icon">＋</span><span><strong>Indemnités non imposables</strong><small>Montants récurrents du salarié</small></span><span class="employee-tab-arrow">→</span></button>
                        <button type="button" class="employee-tab" data-tab="primes"><span class="employee-tab-icon">＋</span><span><strong>Primes imposables</strong><small>Primes fixes récurrentes</small></span><span class="employee-tab-arrow">→</span></button>
                    </div>
                </nav>
                <div class="employee-general-content">
                <!-- Section 1: Informations Personnelles -->
                <div class="form-section">
                    <h2 class="section-title">1. État Civil & Identité</h2>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="nomComplet">Nom complet <span style="color:red;">*</span></label>
                            <input type="text" id="nomComplet" name="nomComplet" class="form-input" required placeholder="ex: Hassan Alami">
                        </div>
                        <div class="form-group">
                            <label for="cin">CIN <span style="color:red;">*</span></label>
                            <input type="text" id="cin" name="cin" class="form-input" required
                                placeholder="ex: AB123456">
                        </div>
                    </div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="dateNaissance">Date de Naissance <span style="color:red;">*</span></label>
                            <input type="date" id="dateNaissance" name="dateNaissance" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="sexe">Sexe <span style="color:red;">*</span></label>
                            <select id="sexe" name="sexe" class="form-input" required>
                                <option value="M">Masculin (M)</option>
                                <option value="F">Féminin (F)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="situationFam">Situation Familiale <span style="color:red;">*</span></label>
                            <select id="situationFam" name="situationFam" class="form-input" required>
                                <option value="CELIBATAIRE">Célibataire</option>
                                <option value="MARIE">Marié(e)</option>
                                <option value="DIVORCE">Divorcé(e)</option>
                                <option value="VEUF">Veuf/Veuve</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="nbEnfantCharge">Enfants à charge</label>
                            <input type="number" id="nbEnfantCharge" name="nbEnfantCharge" class="form-input" min="0"
                                value="0">
                        </div>
                        <div class="form-group">
                            <label for="nbPersonacharge">Personnes à charge (IR cap 6)</label>
                            <input type="number" id="nbPersonacharge" name="nbPersonacharge" class="form-input" min="0"
                                max="6" value="0">
                        </div>
                    </div>
                </div>

                <!-- Section 2: Poste & Contrat -->
                <div class="form-section">
                    <h2 class="section-title">2. Emploi & Contrat</h2>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="matricule">Matricule (Auto si vide)</label>
                            <input type="text" id="matricule" name="matricule" class="form-input"
                                placeholder="ex: EMP-001">
                        </div>
                        <div class="form-group">
                            <label for="functionId">Fonction / Poste</label>
                            <div class="category-select-with-add"><select id="functionId" name="functionId" class="form-input"><option value="">Sélectionner une fonction</option><% (functions || []).forEach(function(item) { %><option value="<%= item.id %>" data-function-code="<%= item.code %>"><%= item.name %></option><% }); %></select><button type="button" class="btn-secondary category-add-button" data-function-add aria-label="Ajouter une fonction">+</button></div>
                            <div id="function-modal" class="app-modal" hidden><div class="app-modal-backdrop" data-close-function></div><div class="app-modal-card category-modal-card" role="dialog" aria-modal="true" aria-labelledby="function-modal-title"><div class="app-modal-header"><div><h2 id="function-modal-title">Ajouter une fonction</h2><p>Créez une fonction et son code service.</p></div><button type="button" class="modal-close" data-close-function>×</button></div><div class="category-modal-field"><label for="new-function-name">Nom de la fonction</label><input id="new-function-name" type="text" class="form-input" data-function-input maxlength="191" placeholder="Ex. Comptable Senior"><label for="new-function-code">Code service / département</label><input id="new-function-code" type="text" class="form-input" data-function-code-input maxlength="64" placeholder="Ex. FIN-01"></div><div class="app-modal-actions"><button type="button" class="btn-secondary" data-close-function>Annuler</button><button type="button" class="btn-primary" data-function-save>Ajouter</button></div></div></div>
                        </div>
                        <div class="form-group">
                            <label for="codeService">Code Service / Département</label>
                            <select id="codeService" name="codeService" class="form-input"><option value="">Sélectionner un code</option><% (functions || []).forEach(function(item) { %><option value="<%= item.code %>" data-function-id="<%= item.id %>"><%= item.code %></option><% }); %></select>
                        </div>
                    </div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="dateEmbauche">Date d'embauche <span style="color:red;">*</span></label>
                            <input type="date" id="dateEmbauche" name="dateEmbauche" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="categoryId">Catégorie <a href="/employees/categories" target="_blank" style="font-size: 12px; margin-left: 6px;">Gérer</a></label>
                            <div class="category-select-with-add"><select id="categoryId" name="categoryId" class="form-input" required><option value="">Sélectionner une catégorie</option><% (categories || []).forEach(function(category) { %><option value="<%= category.id %>"><%= category.name %></option><% }); %></select><button type="button" class="btn-secondary category-add-button" data-category-add aria-label="Ajouter une catégorie">+</button></div>
                            <div id="category-modal" class="app-modal" hidden><div class="app-modal-backdrop" data-close-category></div><div class="app-modal-card category-modal-card" role="dialog" aria-modal="true" aria-labelledby="category-modal-title"><div class="app-modal-header"><div><h2 id="category-modal-title">Ajouter une catégorie</h2><p>Créez une catégorie disponible pour les employés.</p></div><button type="button" class="modal-close" data-close-category>×</button></div><div class="category-modal-field"><label for="new-category-name">Nom de la catégorie</label><input id="new-category-name" type="text" class="form-input" data-category-input maxlength="191" placeholder="Ex. Administration"></div><div class="app-modal-actions"><button type="button" class="btn-secondary" data-close-category>Annuler</button><button type="button" class="btn-primary" data-category-save>Ajouter</button></div></div></div>
                        </div>
                        <div class="form-group">
                            <label for="natureEmploi">Status</label>
                            <select id="natureEmploi" name="natureEmploi" class="form-input"
                                onchange="toggleContractFields(this.value)">
                                <option value="PERMANENT">Permanent (CDI)</option>
                                <option value="OCCASIONNEL">Occasionnel (CDD)</option>
                                <option value="STAGIAIRE">Stagiaire</option>
                                <option value="EXONERE">Exonéré</option>
                                <option value="DOCTORANT">Doctorant</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-grid-3">

                    </div>
                    <div class="form-grid-2" id="contract-fields" hidden>
                        <div class="form-group">
                            <label for="contratDateDebut">Contrat du</label>
                            <input type="date" id="contratDateDebut" name="contratDateDebut" class="form-input">
                        </div>
                        <div class="form-group">
                            <label for="contratDateFin">Contrat au</label>
                            <input type="date" id="contratDateFin" name="contratDateFin" class="form-input">
                        </div>
                    </div>
                    <div class="form-grid-3">


                    </div>
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label for="adresse">Adresse complète</label>
                            <input type="text" id="adresse" name="adresse" class="form-input"
                                placeholder="ex: 15 Bd Zerktouni">
                        </div>
                        <div class="form-group">
                            <label for="ville">Ville</label>
                            <input type="text" id="ville" name="ville" class="form-input" placeholder="ex: Casablanca">
                        </div>
                    </div>
                </div>

                <!-- Section 3: Remunération & Banque -->
                <div class="form-section">
                    <h2 class="section-title">3. Salaire de Base & Coordonnées Bancaires</h2>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="baseSalary">Salaire de Base (DH) <span style="color:red;">*</span></label>
                            <input type="number" step="0.01" id="baseSalary" name="baseSalary" class="form-input"
                                required placeholder="ex: 8500.00">
                            <button type="button" id="net-to-base-open" class="btn-secondary net-to-base-open">Net à
                                payer → Salaire de base</button>
                            <p id="net-to-base-form-state" class="net-to-base-form-state" role="status"></p>
                        </div>
                        <div class="form-group">
                            <label for="cimrRate">Taux CIMR (ex: 0.06 pour 6%)</label>
                            <input type="number" step="0.0001" min="0" max="0.2" id="cimrRate" name="cimrRate"
                                class="form-input" placeholder="0.06">
                        </div>
                        <div class="form-group">
                            <label for="numeroCNSS">N° Immatriculation CNSS</label>
                            <input type="text" id="numeroCNSS" name="numeroCNSS" class="form-input"
                                placeholder="ex: 123456789">
                        </div>

                    </div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="modePaiement">Mode de paiement</label>
                            <select id="modePaiement" name="modePaiement" class="form-input">
                                <option value="VIREMENT">Virement Bancaire</option>
                                <option value="CHEQUE">Chèque</option>
                                <option value="ESPECE">Espèces</option>
                            </select>
                        </div>

                    </div>
                    <div class="form-grid-3">
                        <div class="form-group">
                            <label for="banque">Banque</label>
                            <input type="text" id="banque" name="banque" class="form-input"
                                placeholder="ex: Attijariwafa Bank">
                        </div>
                        <div class="form-group">
                            <label for="agence">Agence</label>
                            <input type="text" id="agence" name="agence" class="form-input"
                                placeholder="ex: Agence Central">
                        </div>
                        <div class="form-group">
                            <label for="rib">RIB (24 chiffres)</label>
                            <input type="text" id="rib" name="rib" class="form-input"
                                placeholder="ex: 225330000000000000000000">
                        </div>
                    </div>
                </div>

                </div>

                <div class="form-section employee-tab-panel" data-panel="indemnites">
                    <div class="representation-employee-card">
                        <div><strong>Indemnité de représentation</strong><small>Calculée automatiquement en pourcentage du salaire de base.</small></div>
                        <label class="representation-employee-control"><input type="checkbox" name="representationEnabled" value="1"><span>Attribuée</span></label>
                        <label class="representation-rate-control"><span>Taux</span><input type="number" name="indemniteRepresentationRate" value="" data-default-rate="<%= defaultRepresentationRate ?? 10 %>" placeholder="<%= defaultRepresentationRate ?? 10 %>" min="0" max="100" step="0.01" disabled><strong>%</strong></label>
                    </div>
                    <div class="section-heading-row"><div><h2 class="section-title" style="margin-bottom: 4px;">Indemnités non imposables</h2><p style="font-size: 13px; color: var(--color-text-subtle); margin: 0;">Attribuez les indemnités récurrentes à ce salarié et ajustez son montant mensuel.</p></div><button type="button" class="btn-primary open-indemnites-modal">+ Ajouter des indemnités</button></div>
                    <div class="table-wrapper" style="margin-top: 20px;"><table class="data-table"><thead><tr><th>Code</th><th>Indemnité</th><th>Montant salarié</th><th>Statut</th></tr></thead><tbody id="employee-indemnity-preview"><tr><td colspan="4" class="empty-state">Aucune indemnité attribuée à ce salarié.</td></tr></tbody></table></div>
                    <div class="indemnites-bottom-action"><span>Vous souhaitez ajouter ou modifier une indemnité ?</span><button type="button" class="btn-primary open-indemnites-modal">+ Ajouter des indemnités</button></div>
                </div>

                <div class="form-section employee-tab-panel" data-panel="primes">
                    <div class="section-heading-row"><div><h2 class="section-title" style="margin-bottom: 4px;">Primes imposables fixes</h2><p style="font-size: 13px; color: var(--color-text-subtle); margin: 0;">Attribuez les primes récurrentes imposables à ce salarié.</p></div></div>
                    <div class="table-wrapper" style="margin-top: 20px;"><table class="data-table"><thead><tr><th>Code</th><th>Prime</th><th>Montant salarié</th><th>Montant par défaut</th></tr></thead><tbody>
                        <% const taxableBonuses = (bonusTypes || []).filter(item => item.taxable); %>
                        <% if (taxableBonuses.length) { taxableBonuses.forEach(function (item) { %>
                            <tr class="employee-prime-row"><td><%= item.code %></td><td><label><input type="checkbox" name="employeePrimeIds" value="<%= item.id %>"> <strong><%= item.name %></strong></label></td><td><input type="number" name="employeePrimeAmounts" class="form-input" min="0.01" step="0.01" value="<%= Number(item.defaultAmount).toFixed(2) %>"></td><td><%= Number(item.defaultAmount).toFixed(2) %> DH</td></tr>
                        <% }); } else { %><tr><td colspan="4" class="empty-state">Aucune prime imposable dans le catalogue.</td></tr><% } %>
                        <tr><td><input type="text" name="newPrimeCodes" class="form-input" placeholder="Code rubrique"></td><td><input type="text" name="newPrimeNames" class="form-input" placeholder="Nouvelle prime imposable"></td><td><input type="number" name="newPrimeAmounts" class="form-input" min="0.01" step="0.01" placeholder="Montant DH"></td><td>Créer dans le catalogue</td></tr>
                    </tbody></table></div>
                    <div class="table-wrapper" style="margin-top: 20px;"><table class="data-table"><thead><tr><th>Code</th><th>Prime imposable</th><th>Montant salarié</th><th>Statut</th></tr></thead><tbody id="employee-prime-preview"><tr><td colspan="4" class="empty-state">Aucune prime fixe attribuée à ce salarié.</td></tr></tbody></table></div>
                </div>

                <!-- Submit Bar -->
                <div class="form-actions-bar" id="employee-submit-bar">
                    <button type="submit" class="btn-primary" style="min-width: 200px;">
                        Enregistrer le salarié
                    </button>
                </div>
            </form>

            <div id="indemnites-modal" class="app-modal" hidden>
                <div class="app-modal-backdrop" data-close-indemnites></div>
                <div class="app-modal-card">
                    <div class="app-modal-header"><div><h2>Ajouter des indemnités</h2><p>Sélectionnez une indemnité, puis personnalisez son montant.</p></div><button type="button" class="modal-close" data-close-indemnites>×</button></div>
                    <div class="indemnite-picker">
                        <% if (indemnites && indemnites.length) { indemnites.forEach(function (item) { %>
                            <label class="indemnite-picker-row"><input type="checkbox" form="employee-create-form" name="employeeIndemniteIds" value="<%= item.id %>"><span class="indemnite-picker-code"><%= item.code %></span><span class="indemnite-picker-name"><strong><%= item.name %></strong><small><%= item.isRepresentation ? 'Taux proposé' : 'Défaut' %> : <%= Number(item.defaultAmount).toFixed(2) %> <%= item.isRepresentation ? '%' : 'DH' %></small></span><input type="number" form="employee-create-form" name="employeeIndemniteAmounts" class="form-input" min="0.01" step="0.01" value="<%= Number(item.defaultAmount).toFixed(2) %>" required><span><%= item.isRepresentation ? '%' : 'DH' %></span></label>
                        <% }); } else { %><p class="empty-state">Aucune indemnité dans le catalogue. Créez-en une ci-dessous.</p><% } %>
                    </div>
                    <div class="inline-create-panel"><strong>Créer depuis cette fenêtre</strong><div id="new-indemnite-rows"></div><button type="button" class="btn-secondary" id="add-new-indemnite">+ Nouvelle indemnité</button></div>
                    <div class="app-modal-actions"><button type="button" class="btn-secondary" data-close-indemnites>Annuler</button><button type="button" class="btn-primary" id="apply-indemnites">Ajouter au salarié</button></div>
                </div>
            </div>

            <script>
                const employeeTabButtons = document.querySelectorAll('.employee-tab');
                const employeePanels = document.querySelectorAll('.employee-tab-panel');
                const employeeGeneral = document.querySelector('.employee-general-content');
                const employeeSubmitBar = document.getElementById('employee-submit-bar');
                const employeeReturnTab = document.getElementById('employee-return-tab');
                employeeTabButtons.forEach(button => button.addEventListener('click', () => {
                    employeeTabButtons.forEach(item => item.classList.toggle('active', item === button));
                    employeePanels.forEach(panel => panel.classList.toggle('active', panel.dataset.panel === button.dataset.tab));
                    employeeGeneral.hidden = button.dataset.tab !== 'general';
                    employeeSubmitBar.hidden = !['general', 'indemnites', 'primes'].includes(button.dataset.tab);
                    employeeReturnTab.value = button.dataset.tab;
                }));

                const indemnitesModal = document.getElementById('indemnites-modal');
                document.querySelectorAll('.open-indemnites-modal').forEach(button => button.addEventListener('click', () => { indemnitesModal.hidden = false; }));
                document.querySelectorAll('[data-close-indemnites]').forEach(button => button.addEventListener('click', () => { indemnitesModal.hidden = true; }));
                const representationEnabled = document.querySelector('input[name="representationEnabled"]');
                const representationRate = document.querySelector('input[name="indemniteRepresentationRate"]');
                representationEnabled.addEventListener('change', () => {
                    if (representationEnabled.checked && !representationRate.value) representationRate.value = representationRate.dataset.defaultRate || '10';
                    representationRate.disabled = !representationEnabled.checked;
                });
                document.querySelectorAll('.indemnite-picker-row').forEach(row => {
                    const checkbox = row.querySelector('input[type="checkbox"]');
                    const amount = row.querySelector('input[type="number"]');
                    const sync = () => { amount.disabled = !checkbox.checked; amount.required = checkbox.checked; };
                    checkbox.addEventListener('change', sync);
                    sync();
                });
                document.querySelectorAll('.employee-prime-row').forEach(row => {
                    const checkbox = row.querySelector('input[type="checkbox"]');
                    const amount = row.querySelector('input[type="number"]');
                    const sync = () => { amount.disabled = !checkbox.checked; };
                    checkbox.addEventListener('change', sync);
                    sync();
                });
                const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
                const renderEmployeeDraftBenefits = () => {
                    const indemnityRows = [...document.querySelectorAll('.indemnite-picker-row')]
                        .filter(row => row.querySelector('input[type="checkbox"]')?.checked)
                        .map(row => ({
                            code: row.querySelector('.indemnite-picker-code')?.textContent.trim(),
                            name: row.querySelector('.indemnite-picker-name strong')?.textContent.trim(),
                            amount: row.querySelector('input[type="number"]')?.value,
                        }));
                    document.querySelectorAll('#new-indemnite-rows .new-indemnite-row').forEach(row => {
                        const inputs = row.querySelectorAll('input');
                        if (inputs[0]?.value.trim() && inputs[1]?.value.trim() && Number(inputs[2]?.value) > 0) {
                            indemnityRows.push({ code: inputs[0].value, name: inputs[1].value, amount: inputs[2].value });
                        }
                    });
                    document.getElementById('employee-indemnity-preview').innerHTML = indemnityRows.length
                        ? indemnityRows.map(item => `<tr><td>${escapeHtml(item.code)}</td><td>${escapeHtml(item.name)}</td><td>${Number(item.amount).toFixed(2)} DH</td><td><span class="badge badge-actif">En mémoire</span></td></tr>`).join('')
                        : '<tr><td colspan="4" class="empty-state">Aucune indemnité attribuée à ce salarié.</td></tr>';

                    const primeRows = [...document.querySelectorAll('.employee-prime-row')]
                        .filter(row => row.querySelector('input[type="checkbox"]')?.checked)
                        .map(row => ({ code: row.cells[0]?.textContent.trim(), name: row.querySelector('strong')?.textContent.trim(), amount: row.querySelector('input[type="number"]')?.value }));
                    const newPrimeCode = document.querySelector('[name="newPrimeCodes"]')?.value.trim();
                    const newPrimeName = document.querySelector('[name="newPrimeNames"]')?.value.trim();
                    const newPrimeAmount = document.querySelector('[name="newPrimeAmounts"]')?.value;
                    if (newPrimeCode && newPrimeName && Number(newPrimeAmount) > 0) primeRows.push({ code: newPrimeCode, name: newPrimeName, amount: newPrimeAmount });
                    document.getElementById('employee-prime-preview').innerHTML = primeRows.length
                        ? primeRows.map(item => `<tr><td>${escapeHtml(item.code)}</td><td>${escapeHtml(item.name)}</td><td>${Number(item.amount).toFixed(2)} DH</td><td><span class="badge badge-actif">En mémoire</span></td></tr>`).join('')
                        : '<tr><td colspan="4" class="empty-state">Aucune prime fixe attribuée à ce salarié.</td></tr>';
                };
                document.querySelectorAll('.employee-prime-row input, [name="newPrimeCodes"], [name="newPrimeNames"], [name="newPrimeAmounts"]').forEach(input => input.addEventListener('input', renderEmployeeDraftBenefits));
                document.getElementById('add-new-indemnite').addEventListener('click', () => {
                    const row = document.createElement('div');
                    row.className = 'new-indemnite-row';
                    row.innerHTML = '<input type="text" name="newIndemniteCodes" form="employee-create-form" class="form-input" placeholder="Code rubrique" required><input type="text" name="newIndemniteNames" form="employee-create-form" class="form-input" placeholder="Nom de l’indemnité" required><input type="number" name="newIndemniteAmounts" form="employee-create-form" class="form-input" min="0.01" step="0.01" placeholder="Montant DH" required><button type="button" class="remove-inline-row">×</button>';
                    row.querySelector('.remove-inline-row').addEventListener('click', () => { row.remove(); renderEmployeeDraftBenefits(); });
                    document.getElementById('new-indemnite-rows').appendChild(row);
                    row.querySelectorAll('input').forEach(input => input.addEventListener('input', renderEmployeeDraftBenefits));
                });
                document.getElementById('apply-indemnites').addEventListener('click', () => { renderEmployeeDraftBenefits(); indemnitesModal.hidden = true; document.querySelector('[data-tab="indemnites"]').click(); });
                document.querySelectorAll('.indemnite-picker-row input').forEach(input => {
                    input.addEventListener('input', renderEmployeeDraftBenefits);
                    input.addEventListener('change', renderEmployeeDraftBenefits);
                });
                renderEmployeeDraftBenefits();

                const categoryModal = document.getElementById('category-modal');
                const categoryInput = document.querySelector('[data-category-input]');
                document.querySelector('[data-category-add]').addEventListener('click', () => { categoryModal.hidden = false; categoryInput.focus(); });
                document.querySelectorAll('[data-close-category]').forEach(button => button.addEventListener('click', () => { categoryModal.hidden = true; categoryInput.value = ''; }));
                document.querySelector('[data-category-save]').addEventListener('click', async () => {
                    const name = categoryInput.value.trim();
                    if (!name) return categoryInput.focus();
                    const response = await fetch('/employees/categories/inline', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ name }) });
                    const result = await response.json();
                    if (!response.ok) return alert(result.error || 'Impossible d’ajouter la catégorie.');
                    document.getElementById('categoryId').add(new Option(result.name, result.id, true, true));
                    categoryModal.hidden = true;
                    categoryInput.value = '';
                });
                const functionModal = document.getElementById('function-modal');
                const functionInput = document.querySelector('[data-function-input]');
                const functionCodeInput = document.querySelector('[data-function-code-input]');
                const functionSelect = document.getElementById('functionId');
                const codeSelect = document.getElementById('codeService');
                document.querySelector('[data-function-add]').addEventListener('click', () => { functionModal.hidden = false; functionInput.focus(); });
                document.querySelectorAll('[data-close-function]').forEach(button => button.addEventListener('click', () => { functionModal.hidden = true; functionInput.value = ''; functionCodeInput.value = ''; }));
                functionSelect.addEventListener('change', () => { const option = functionSelect.selectedOptions[0]; codeSelect.value = option?.dataset.functionCode || ''; });
                codeSelect.addEventListener('change', () => { const option = codeSelect.selectedOptions[0]; functionSelect.value = option?.dataset.functionId || ''; });
                document.querySelector('[data-function-save]').addEventListener('click', async () => {
                    const name = functionInput.value.trim();
                    const code = functionCodeInput.value.trim();
                    if (!name) return functionInput.focus();
                    if (!code) return functionCodeInput.focus();
                    const response = await fetch('/employees/functions/inline', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ name, code }) });
                    const result = await response.json();
                    if (!response.ok) return alert(result.error || 'Impossible d’ajouter la fonction.');
                    functionSelect.add(new Option(result.name, result.id, true, true));
                    codeSelect.add(new Option(result.code, result.code, true, true));
                    codeSelect.selectedOptions[0].dataset.functionId = result.id;
                    functionModal.hidden = true;
                    functionInput.value = '';
                    functionCodeInput.value = '';
                });

                function toggleContractFields(nature) {
                    const contractFields = document.getElementById('contract-fields');
                    const contractInputs = contractFields.querySelectorAll('input');
                    const isCdd = nature === 'OCCASIONNEL';
                    contractFields.hidden = !isCdd;
                    contractInputs.forEach(input => { input.disabled = !isCdd; });
                }
                toggleContractFields(document.getElementById('natureEmploi').value);
            </script>

