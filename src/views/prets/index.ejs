<%- include('../partials/header') %>
<style>
.prets-page{max-width:1180px;margin:0 auto;padding:28px 22px}.prets-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px}.prets-header h1{margin:4px 0 6px}.prets-card{background:#fff;border:1px solid var(--line,#dfe7eb);border-radius:12px;box-shadow:0 8px 24px rgba(21,48,68,.06);overflow:hidden}.prets-table{width:100%;border-collapse:collapse}.prets-table th,.prets-table td{padding:13px 16px;border-bottom:1px solid #e8eef1;text-align:left}.prets-table th{background:#f5f9fb;color:#607486;font-size:12px;text-transform:uppercase}.prets-table td.num{text-align:right}.prets-dialog{border:0;border-radius:14px;padding:24px;width:min(460px,calc(100% - 28px));box-shadow:0 22px 70px rgba(15,45,65,.25)}.prets-dialog::backdrop{background:rgba(16,38,51,.42)}.prets-fields{display:grid;gap:14px}.prets-fields label{display:grid;gap:6px;color:#526a78;font-weight:600;font-size:13px}.prets-fields input,.prets-fields select{padding:10px;border:1px solid #ccd9df;border-radius:7px;font:inherit}.prets-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.prets-actions button{padding:10px 15px;border:1px solid #c9d7dd;border-radius:7px;background:#fff}.prets-actions .confirm{background:#176b5b;color:#fff;border-color:#176b5b}.edit-pret{padding:6px 10px;border:1px solid #c9d7dd;border-radius:7px;background:#fff}.solde-positive{color:#0f766e;font-weight:700}.empty-state{text-align:center;color:#80909a;padding:34px!important}
</style>
<main class="prets-page"><div class="prets-header"><div><div class="eyebrow">Gestion financière</div><h1 class="page-title">Prêts employés</h1><p class="page-subtitle">Déduisez librement une partie du prêt chaque mois jusqu’à son remboursement.</p></div><button type="button" class="simple-primary" id="open-pret-dialog">+ Nouveau prêt</button></div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %><% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<section class="prets-card"><table class="prets-table"><thead><tr><th>Matricule</th><th>Employé</th><th>Montant</th><th>Mensualité</th><th>Solde restant</th><th>Date</th></tr></thead><tbody>
<% if (!prets.length) { %><tr><td colspan="7" class="empty-state">Aucun prêt enregistré.</td></tr><% } %><% prets.forEach(pret => { %><tr><td><%= pret.employee.matricule %></td><td><%= pret.employee.nomComplet %></td><td class="num"><%= Number(pret.amount).toFixed(2) %> DH</td><td class="num"><%= Number(pret.monthlyAmount).toFixed(2) %> DH</td><td class="num solde-positive"><%= Number(pret.solde).toFixed(2) %> DH</td><td><%= new Date(pret.date).toLocaleDateString('fr-MA') %></td><td><button type="button" class="edit-pret" data-id="<%= pret.id %>" data-amount="<%= Number(pret.amount).toFixed(2) %>" data-monthly="<%= Number(pret.monthlyAmount).toFixed(2) %>">Modifier</button></td></tr><% }); %>
</tbody></table></section></main>
<dialog class="prets-dialog" id="pret-dialog"><form method="POST" action="/prets"><h2>Nouveau prêt</h2><div class="prets-fields"><label>Employé<select name="matricule" required><option value="" selected disabled>Choisir un employé</option><% employees.forEach(employee => { %><option value="<%= employee.matricule %>"><%= employee.matricule %> — <%= employee.nomComplet %></option><% }); %></select></label><label>Montant total du prêt<input name="amount" required type="number" min="0.01" step="0.01"></label><label>Mensualité automatique<input name="monthlyAmount" required type="number" min="0" step="0.01"><small>Cette valeur sera proposée automatiquement sur chaque bulletin et reste modifiable.</small></label><label>Date<input name="date" required type="date" value="<%= new Date().toISOString().slice(0, 10) %>"></label></div><div class="prets-actions"><button type="button" id="close-pret-dialog">Annuler</button><button class="confirm" type="submit">Enregistrer</button></div></form></dialog>
<dialog class="prets-dialog" id="edit-pret-dialog"><form method="POST" id="edit-pret-form"><h2>Modifier le prêt</h2><div class="prets-fields"><label>Montant total du prêt<input name="amount" id="edit-pret-amount" required type="number" min="0.01" step="0.01"></label><label>Mensualité automatique<input name="monthlyAmount" id="edit-pret-monthly" required type="number" min="0" step="0.01"></label></div><div class="prets-actions"><button type="button" id="close-edit-pret-dialog">Annuler</button><button class="confirm" type="submit">Enregistrer</button></div></form></dialog>
<script>const pretDialog=document.getElementById('pret-dialog');document.getElementById('open-pret-dialog')?.addEventListener('click',()=>pretDialog?.showModal());document.getElementById('close-pret-dialog')?.addEventListener('click',()=>pretDialog?.close());const editPretDialog=document.getElementById('edit-pret-dialog');const editPretForm=document.getElementById('edit-pret-form');document.querySelectorAll('.edit-pret').forEach(button=>button.addEventListener('click',()=>{editPretForm.action=`/prets/${button.dataset.id}/edit`;document.getElementById('edit-pret-amount').value=button.dataset.amount;document.getElementById('edit-pret-monthly').value=button.dataset.monthly;editPretDialog.showModal()}));document.getElementById('close-edit-pret-dialog')?.addEventListener('click',()=>editPretDialog?.close());</script>
<%- include('../partials/footer') %>
