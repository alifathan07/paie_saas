            </summary>
            <div class="sidebar-dropdown-children">
                <a href="/parametrage" class="sidebar-sub-link <%= typeof currentPage !== 'undefined' && currentPage === 'parametrage' ? 'active' : '' %>"><span class="sidebar-sub-icon">⚙</span>Paramétrage</a>
