        <a href="/admin/reports" class="sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'reports' ? 'active' : '' %>"><span class="sidebar-link-icon">!</span><span>Rapports</span></a>
        <a href="/admin/audit-logs" class="sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'audit' ? 'active' : '' %>"><span class="sidebar-link-icon">↗</span><span>Journal d’activité</span></a>
        <a href="/admin/system" class="sidebar-link <%= typeof adminNav !== 'undefined' && (adminNav === 'system' || adminNav === 'usage') ? 'active' : '' %>"><span class="sidebar-link-icon">⚙</span><span>Système</span></a>
        <% } else { %>
