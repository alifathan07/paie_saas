<aside class="sidebar" id="app-sidebar">
    <div class="sidebar-brand">
        <div class="brand-row">
            <div class="brand-icon">P</div>
            <div class="brand-text">
                <div class="brand-name">Paie Software</div>
                <div class="brand-sub">Gestion RH & Paie</div>
            </div>
        </div>
        <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-controls="app-sidebar" aria-expanded="true" aria-label="Réduire le menu">‹</button>
    </div>
    <nav class="sidebar-nav">
        <% if (isAdmin && !clientMode) { %>
        <div class="sidebar-section-label">Pilotage</div>
        <a href="/admin" class="sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'overview' ? 'active' : '' %>">
            <span class="sidebar-link-icon">⌂</span><span>Vue d’ensemble</span>
        </a>
        <a href="/admin/clients" class="sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'clients' ? 'active' : '' %>"><span class="sidebar-link-icon">◉</span><span>Clients</span></a>
        <a href="/admin/companies" class="sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'companies' ? 'active' : '' %>"><span class="sidebar-link-icon">▦</span><span>Sociétés</span></a>
