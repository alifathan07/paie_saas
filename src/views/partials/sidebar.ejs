        </details>
        <details class="sidebar-dropdown" <%= typeof currentPage !== 'undefined' && (currentPage === 'indemnites' || currentPage === 'primes') ? 'open' : '' %>>
            <summary class="sidebar-dropdown-toggle"><svg class="sidebar-nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Z"/><path d="M3 9h18M16 14h2"/></svg><a href="/indemnites" class="sidebar-dropdown-summary-link">Primes et indemnités</a><span class="sidebar-dropdown-arrow" aria-hidden="true"></span></summary>
