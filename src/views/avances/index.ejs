<%- include('../partials/header') %>

<style>
    .avances-page{max-width:1180px;margin:0 auto;padding:28px 22px}.avances-header{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}.avances-header h1{margin:4px 0 6px}.avances-toolbar{display:flex;justify-content:flex-end;margin-bottom:14px}.avances-filter{width:min(360px,100%);padding:10px 12px;border:1px solid #ccd9df;border-radius:7px;font:inherit;background:#fff}.avances-card{background:#fff;border:1px solid var(--line,#dfe7eb);border-radius:12px;box-shadow:0 8px 24px rgba(21,48,68,.06);overflow:hidden}.avances-table{width:100%;border-collapse:collapse}.avances-table th,.avances-table td{padding:13px 16px;border-bottom:1px solid #e8eef1;text-align:left}.avances-table th{background:#f5f9fb;color:#607486;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.avances-table td.num{text-align:right}.avances-table tr:last-child td{border-bottom:0}.solde-positive{color:#0f766e;font-weight:700}.solde-zero{color:#8796a0}.avance-dialog{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);margin:0;border:0;border-radius:14px;padding:0;width:min(460px,calc(100% - 28px));max-height:calc(100vh - 28px);box-shadow:0 22px 70px rgba(15,45,65,.25)}.avance-dialog::backdrop{background:rgba(16,38,51,.42)}.avance-dialog form{padding:24px}.avance-dialog h2{margin:0 0 18px}.avance-fields{display:grid;gap:14px}.avance-fields label{display:grid;gap:6px;color:#526a78;font-weight:600;font-size:13px}.avance-fields input,.avance-fields select{padding:10px;border:1px solid #ccd9df;border-radius:7px;font:inherit;background:#fff}.avance-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.avance-actions button{padding:10px 15px;border:1px solid #c9d7dd;border-radius:7px;background:#fff}.avance-actions .confirm{background:#176b5b;color:#fff;border-color:#176b5b}.empty-state{text-align:center;color:#80909a;padding:34px!important}
</style>

<main class="avances-page">
    <div class="avances-header">
        <div><div class="eyebrow">Gestion financière</div><h1 class="page-title">Avances sur salaire</h1><p class="page-subtitle">Suivez les montants accordés et les soldes restant à déduire.</p></div>
        <button type="button" class="simple-primary" id="open-avance-dialog">+ Nouvelle avance</button>
    </div>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <div class="avances-toolbar">
        <input class="avances-filter" id="avances-filter" type="search" placeholder="Filtrer par matricule ou employé…" autocomplete="off" aria-label="Filtrer les avances par employé">
    </div>
    <section class="avances-card">
        <table class="avances-table">
            <thead><tr><th>Matricule</th><th>Employé</th><th>Montant</th><th>Solde</th><th>Date</th></tr></thead>
            <tbody>
                <% if (!avances.length) { %><tr><td colspan="5" class="empty-state">Aucune avance enregistrée.</td></tr><% } %>
                <% avances.forEach(avance => { %>
                    <tr class="avance-row" data-employee="<%= `${avance.employee.matricule} ${avance.employee.nomComplet}`.toLowerCase() %>"><td><%= avance.employee.matricule %></td><td><%= avance.employee.nomComplet %></td><td class="num"><%= Number(avance.amount).toFixed(2) %> DH</td><td class="num <%= Number(avance.solde) > 0 ? 'solde-positive' : 'solde-zero' %>"><%= Number(avance.solde).toFixed(2) %> DH</td><td><%= new Date(avance.date).toLocaleDateString('fr-MA') %></td></tr>
                <% }); %>
                <tr id="avances-no-results" hidden><td colspan="5" class="empty-state">Aucune avance ne correspond à ce filtre.</td></tr>
            </tbody>
        </table>
    </section>
</main>

<dialog class="avance-dialog" id="avance-dialog">
    <form method="POST" action="/avances">
        <h2>Nouvelle avance</h2>
        <div class="avance-fields">
            <label>Matricule de l’employé
                <select name="matricule" required <%= employees.length ? '' : 'disabled' %>>
                    <option value="" selected disabled>Choisir un employé</option>
                    <% employees.forEach(employee => { %><option value="<%= employee.matricule %>"><%= employee.matricule %> — <%= employee.nomComplet %></option><% }); %>
                </select>
            </label>
            <label>Montant<input name="amount" required type="number" min="0.01" step="0.01" placeholder="Ex. 1 500,00"></label>
            <label>Date<input name="date" required type="date" value="<%= new Date().toISOString().slice(0, 10) %>"></label>
        </div>
        <div class="avance-actions"><button type="button" id="close-avance-dialog">Annuler</button><button class="confirm" type="submit" <%= employees.length ? '' : 'disabled' %>>Enregistrer</button></div>
    </form>
</dialog>
<script>
    const avanceDialog = document.getElementById('avance-dialog');
    document.getElementById('open-avance-dialog')?.addEventListener('click', () => avanceDialog?.showModal());
    document.getElementById('close-avance-dialog')?.addEventListener('click', () => avanceDialog?.close());
    const avancesFilter = document.getElementById('avances-filter');
    const avanceRows = [...document.querySelectorAll('.avance-row')];
    const avancesNoResults = document.getElementById('avances-no-results');
    avancesFilter?.addEventListener('input', () => {
        const query = avancesFilter.value.trim().toLowerCase();
        let visible = 0;
        avanceRows.forEach(row => {
            const match = !query || row.dataset.employee.includes(query);
            row.hidden = !match;
            if (match) visible++;
        });
        if (avancesNoResults) avancesNoResults.hidden = visible !== 0;
    });
</script>
<%- include('../partials/footer') %>
