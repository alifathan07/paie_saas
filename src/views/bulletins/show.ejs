<style>
    .payroll-print {
        --ink: #17202a;
        --muted: #66727e;
        --line: #d8dee5;
        --soft: #f4f7f9;
        --accent: #176b5b;
        --accent-dark: #0f5145;
        --danger: #b42318;
        max-width: 1120px;
        margin: 32px auto;
        padding: 32px;
        border: 1px solid #cbd3da;
        border-radius: 10px;
        background: #fff;
        color: var(--ink);
        box-shadow: 0 12px 30px rgba(23, 32, 42, 0.08);
    }

    .payroll-print .print-title {
        margin: 4px 0 28px;
        color: var(--ink);
        font-size: 26px;
        letter-spacing: 0.08em;
    }

    .payroll-print .bulletin-status {
        display: grid;
        gap: 4px;
        margin: 0 0 20px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        background: var(--soft);
        color: var(--ink);
    }

    .payroll-print .bulletin-status span {
        color: var(--muted);
        font-size: 15px;
    }

    .payroll-print .delete-confirm-dialog .delete-confirm-submit {
        border-color: #b42318;
        background: #b42318;
        color: #fff;
    }

    .payroll-print .delete-confirm-dialog .delete-confirm-submit:hover {
        background: #8f1d14;
    }

    .payroll-print .print-actions {
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

    .payroll-print .return-action {
        margin-right: auto;
    }

    .payroll-print .print-button,
    .payroll-print .add-prime {
        border: 1px solid #aeb9c3;
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .payroll-print .print-button:hover,
    .payroll-print .add-prime:hover {
        border-color: var(--accent);
        color: var(--accent-dark);
        background: #f0f8f5;
    }

    .payroll-print .print-button:focus-visible,
    .payroll-print .add-prime:focus-visible,
    .payroll-print .remove-prime:focus-visible,
    .payroll-print input:focus-visible {
        outline: 3px solid rgba(23, 107, 91, 0.24);
        outline-offset: 2px;
    }

    .payroll-print .print-button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
    }

    .payroll-print .print-button.primary:hover {
        border-color: var(--accent-dark);
        background: var(--accent-dark);
    }

    .payroll-print .employee-info {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
    }

    .payroll-print .employee-info .item {
        min-height: 58px;
        padding: 11px 13px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .payroll-print .employee-info .item:nth-child(4n) {
        border-right: 0;
    }

    .payroll-print .employee-info .item:nth-last-child(-n + 4) {
        border-bottom: 0;
    }

    .payroll-print .employee-info .label {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.06em;
    }

    .payroll-print .employee-edit,
    .payroll-print .salary-edit,
    .payroll-print .pay-table input {
        border-color: #b9c4cc;
        border-radius: 4px;
        color: var(--ink);
    }

    .payroll-print .pay-table {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 8px;
        border-collapse: separate;
        border-spacing: 0;
        box-shadow: 0 3px 10px rgba(23, 32, 42, 0.04);
    }

    .payroll-print .pay-table th {
        padding: 10px 9px;
        border-color: #c5ced6;
        background: #e9f0f2;
        color: #26343d;
        font-size: 13px;
        letter-spacing: 0.04em;
    }

    .payroll-print .pay-table td {
        padding: 9px;
        border-color: var(--line);
    }

    .payroll-print .pay-table tbody tr:nth-child(even):not(.gross):not(.net):not(.disabled-row) {
        background: #fbfcfd;
    }

    .payroll-print .pay-table .gross {
        background: #eef5f3;
        color: #173f37;
    }

    .payroll-print .pay-table .net,
    .payroll-print .totals .net {
        background: #dcefe9;
        color: #123e34;
    }

    .payroll-print .pay-table .disabled-row {
        background: #f7f8f9;
        color: #5e6972;
    }

    .payroll-print .pay-table .num,
    .payroll-print .totals .num {
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .payroll-print .remove-prime {
        min-width: 28px;
        min-height: 28px;
        margin-left: 6px;
        border: 1px solid #f0c4c0;
        border-radius: 50%;
        background: #fff7f6;
        color: var(--danger);
        font-size: 20px;
        line-height: 1;
    }

    .payroll-print .remove-prime:hover {
        border-color: var(--danger);
        background: #fdecea;
    }

    .payroll-print .totals {
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
    }

    .payroll-print .totals td {
        padding: 9px 11px;
        border-color: var(--line);
    }

    .payroll-print #calculation-state,
    .payroll-print #calculation-error {
        margin-top: 14px;
        color: var(--muted);
        font-size: 14px;
    }

    .payroll-print #calculation-error {
        padding: 10px 12px;
        border-left: 3px solid var(--danger);
        background: #fff4f2;
        color: #8f2118;
    }

    .payroll-print .prime-dialog {
        max-width: calc(100% - 32px);
        border: 1px solid #cbd3da;
        border-radius: 10px;
        box-shadow: 0 20px 60px rgba(23, 32, 42, 0.22);
    }

    .payroll-print .prime-dialog-content {
        padding: 26px;
    }

    .payroll-print .prime-dialog h2 {
        color: var(--ink);
        font-size: 21px;
    }

    .payroll-print .prime-dialog p {
        color: var(--muted);
        line-height: 1.5;
    }

    .payroll-print .prime-dialog-fields input {
        border-color: #b9c4cc;
        border-radius: 6px;
    }

    .payroll-print .prime-dialog-actions button {
        border-radius: 6px;
    }

    @media (max-width: 760px) {
        .payroll-print {
            margin: 12px;
            padding: 18px;
            border-radius: 8px;
        }

        .payroll-print .employee-info {
            grid-template-columns: repeat(2, 1fr);
        }

        .payroll-print .employee-info .item:nth-child(4n) {
            border-right: 1px solid var(--line);
        }

        .payroll-print .employee-info .item:nth-child(2n) {
            border-right: 0;
        }

        .payroll-print .employee-info .item:nth-last-child(-n + 4) {
            border-bottom: 1px solid var(--line);
        }

        .payroll-print .employee-info .item:nth-last-child(-n + 2) {
            border-bottom: 0;
        }

        .payroll-print .pay-table {
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }
    }

    @media print {
        .payroll-print {
            max-width: none;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .payroll-print .print-actions,
        .payroll-print #calculation-state,
        .payroll-print #calculation-error,
        .payroll-print dialog {
            display: none !important;
        }

        .payroll-print .pay-table,
        .payroll-print .totals {
            box-shadow: none;
        }
    }

    /* Corporate payroll workspace overrides */
    .payroll-print {
        --ink: #17212b;
        --muted: #687684;
        --line: #d8e0e7;
        --soft: #f5f8fa;
        --accent: #0d6b5d;
        --accent-dark: #084f46;
        --danger: #b42318;
        max-width: 1180px;
        margin: 24px auto 48px;
