    }

    .payroll-print .employee-edit:disabled,
    .payroll-print .pay-table input:disabled {
        border-color: transparent;
        background: #f3f6f8;
        color: #65727e;
        cursor: not-allowed;
    }

    .payroll-print .bulletin-status {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin: 0 0 20px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 5px;
        background: var(--soft);
    }

    .payroll-print .bulletin-status strong {
        white-space: nowrap;
    }

    .payroll-print .bulletin-status span {
        color: var(--muted);
        font-size: 15px;
    }

    .payroll-print .pay-table {
        width: 100%;
        margin-top: 22px;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 6px;
        font-size: 15px;
    }

    .payroll-print .pay-table th {
        padding: 11px 10px;
        border-bottom: 1px solid #c7d2db;
        background: #edf3f5;
        color: #43515d;
        font-size: 12px;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .payroll-print .pay-table td {
        padding: 9px 10px;
        border-bottom: 1px solid #e5ebef;
    }

    .payroll-print .pay-table tr:last-child td {
        border-bottom: 0;
    }

    .payroll-print .pay-table .gross {
        background: #f7fafb;
        color: #263642;
        font-weight: 700;
    }

    .payroll-print .pay-table .net,
    .payroll-print .totals .net {
        background: #e8f4f0;
        color: #084f46;
    }

    .payroll-print .pay-table input {
        border: 1px solid #c4ced7;
        border-radius: 4px;
        padding: 6px 8px;
        background: #fff;
        font: inherit;
    }

    .payroll-print .pay-table input:focus-visible,
    .payroll-print .employee-edit:focus-visible,
    .payroll-print .print-button:focus-visible,
    .payroll-print .add-prime:focus-visible,
    .payroll-print .remove-prime:focus-visible {
        outline: 3px solid rgba(13, 107, 93, .2);
        outline-offset: 2px;
    }

    .payroll-print .totals {
        margin-top: 18px;
        max-width: 460px;
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow: hidden;
    }

    .payroll-print .totals td {
        padding: 10px 12px;
        border-bottom: 1px solid #e5ebef;
    }

    .payroll-print .totals tr:last-child td {
        border-bottom: 0;
    }

        .payroll-print .net-pay-cell {
            padding: 18px 0 0;
            border: 0;
            background: #fff;
            text-align: right;
        }

        .payroll-print .net-pay-callout-content {
            display: inline-block;
            width: min(360px, 100%);
            box-sizing: border-box;
            padding: 14px 18px;
            border: 2px solid var(--accent);
            border-radius: 6px;
            background: #e8f4f0;
            color: var(--accent-dark);
            text-align: right;
        }

        .payroll-print .net-pay-callout-label {
            display: block;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .05em;
        }

        .payroll-print .net-pay-callout-value {
            display: block;
            margin-top: 4px;
            font-size: 26px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
        }

    .payroll-print .annual-cumulative {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 6px;
        background: var(--soft);
    }

    .payroll-print .annual-cumulative-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
