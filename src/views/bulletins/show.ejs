        color: #084f46;
    }

    .payroll-print .pay-table input {
        border: 1px solid #c4ced7;
        border-radius: 4px;
        padding: 6px 8px;
        background: #fff;
        font: inherit;
    }

    .payroll-print .pay-table input:focus-visible,
    .payroll-print .employee-edit:focus-visible,
    .payroll-print .print-button:focus-visible,
    .payroll-print .add-prime:focus-visible,
    .payroll-print .remove-prime:focus-visible {
        outline: 3px solid rgba(13, 107, 93, .2);
        outline-offset: 2px;
    }

    .payroll-print .totals {
        margin-top: 18px;
        max-width: 460px;
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow: hidden;
    }

    .payroll-print .totals td {
        padding: 10px 12px;
        border-bottom: 1px solid #e5ebef;
    }

    .payroll-print .totals tr:last-child td {
        border-bottom: 0;
    }

        .payroll-print .net-pay-cell {
