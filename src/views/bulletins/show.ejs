        box-shadow: 0 14px 34px rgba(23, 33, 43, 0.08);
    }

    .payroll-print .print-title {
        margin: 2px 0 22px;
        color: #17212b;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .payroll-print .print-actions {
        display: flex;
        align-items: center;
