</style>
<style id="bulletin-responsive">
    .bulletin-workspace,
    .bulletin-workspace > .payroll-print,
    .payroll-print,
    .payroll-print .pay-table {
        min-width: 0;
        box-sizing: border-box;
    }

    .bulletin-workspace {
        width: 100%;
        max-width: 1450px;
        padding: 0 16px;
    }

    .bulletin-workspace > .payroll-print {
        width: 100%;
    }

    @media (max-width: 900px) {
        .bulletin-workspace {
            display: block;
            padding: 0 10px;
        }

        .bulletin-employee-panel {
            position: relative;
            top: auto;
            width: auto;
            max-height: none;
            margin: 0 0 12px;
        }

        .bulletin-workspace > .payroll-print {
            width: 100%;
            margin: 0;
        }

        .payroll-print .print-actions {
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .payroll-print .employee-info {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .payroll-print .pay-table {
            display: block;
            width: 100%;
            max-width: 100%;
            overflow: visible;
            white-space: normal;
            border: 0;
            box-shadow: none;
        }

        .payroll-print .pay-table thead { display: none; }

        .payroll-print .pay-table tbody,
        .payroll-print .pay-table tr { display: block; }

        .payroll-print .pay-table tr {
            margin: 0 0 10px;
            border: 1px solid var(--line);
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
        }

        .payroll-print .pay-table td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            width: auto;
            min-height: 38px;
            padding: 8px 10px;
            border: 0;
            border-bottom: 1px solid var(--line);
            text-align: right;
            white-space: normal;
        }

        .payroll-print .pay-table td:last-child { border-bottom: 0; }

        .payroll-print .pay-table td::before {
            flex: 0 0 38%;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .04em;
            text-align: left;
        }

        .payroll-print .pay-table td:nth-child(1)::before { content: "RUB"; }
        .payroll-print .pay-table td:nth-child(2)::before { content: "LIBELLÉ"; }
        .payroll-print .pay-table td:nth-child(3)::before { content: "NBR / BASE"; }
        .payroll-print .pay-table td:nth-child(4)::before { content: "TAUX"; }
        .payroll-print .pay-table td:nth-child(5)::before { content: "GAINS"; }
        .payroll-print .pay-table td:nth-child(6)::before { content: "RETENUES"; }
        .payroll-print .pay-table td:nth-child(7)::before { content: "COTIS. PATR."; }

        .payroll-print .pay-table td.description {
            display: grid;
            grid-template-columns: 38% minmax(0, 1fr);
            align-items: center;
            text-align: left;
        }

        .payroll-print .pay-table td.description::before { grid-column: 1; }

        .payroll-print .pay-table td.description > *,
        .payroll-print .pay-table td.description > input {
            grid-column: 2;
            min-width: 0;
        }

        .payroll-print .pay-table td[colspan] {
            display: block;
            text-align: left;
        }

        .payroll-print .pay-table td[colspan]::before {
            display: block;
            margin-bottom: 4px;
        }

        .payroll-print .pay-table input {
            max-width: 100%;
            min-width: 0!important;
        }

    }

    @media (max-width: 768px) {
        html,
        body {
            max-width: 100%;
            overflow-x: hidden;
        }

        .main-wrapper,
        .page-content {
            min-width: 0;
            width: 100%;
            max-width: 100%;
        }

        .main-wrapper {
            width: calc(100% - 64px);
        }

        .page-content {
            padding: 16px 8px;
            overflow-x: hidden;
        }

        .bulletin-workspace {
            padding: 0;
        }

        .payroll-print {
            padding: 16px 10px 20px !important;
            margin: 0 0 20px !important;
        }

        .payroll-print .print-title {
            font-size: 20px;
            line-height: 1.25;
            letter-spacing: .03em;
        }

        .payroll-print .print-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 7px;
        }

        .payroll-print .print-actions .print-button,
        .payroll-print .print-actions .add-prime {
            width: 100%;
            min-width: 0;
            min-height: 40px;
            padding: 8px 7px;
            font-size: 12px;
            line-height: 1.2;
        }

        .payroll-print .return-action {
            margin-right: 0;
        }

        .payroll-print .employee-info {
            grid-template-columns: 1fr;
        }

        .payroll-print .employee-info .item,
        .payroll-print .employee-info .item:nth-child(2n),
        .payroll-print .employee-info .item:nth-child(4n) {
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }

        .payroll-print .employee-info .item:last-child {
            border-bottom: 0;
        }

        .payroll-print .totals {
            width: 100%;
            max-width: none;
        }

        .payroll-print .prime-dialog {
            width: calc(100vw - 24px);
            max-width: none;
        }

        .payroll-print .prime-dialog-content {
            padding: 16px;
        }

        .payroll-print .prime-dialog-actions {
            flex-wrap: wrap;
        }

        .payroll-print .prime-dialog-actions button {
            flex: 1 1 120px;
            min-width: 0;
        }
    }

    @media (max-width: 380px) {
        .payroll-print .print-actions {
            grid-template-columns: 1fr;
        }

        .payroll-print .annual-cumulative-grid {
            grid-template-columns: 1fr;
        }

        .bulletin-employee-panel-header {
            padding: 12px;
        }
    }

</style>
<%
    const values = bulletin || previewResult || {};
    const workingTimeMode = values.workingTimeMode || emp.company?.workingTimeMode || 'DAYS';
    const standardMonthlyDays = Number(values.standardMonthlyDays || emp.company?.standardMonthlyDays || 26);
    const standardMonthlyHours = Number(values.standardMonthlyHours || emp.company?.standardMonthlyHours || 191);
    const bulletinStatus = bulletin?.status || 'draft';
    const payrollBlocked = Boolean(!emp.actif || emp.blocageSaisiePaie);
    const locked = payrollBlocked || Boolean(bulletin && ['validated', 'closed'].includes(bulletinStatus));
    const closed = bulletinStatus === 'closed';
    const canManageIndemnity = !payrollBlocked && (!bulletin || ['draft', 'generated', 'validated', 'closed'].includes(bulletinStatus));
    const canEditIndemnityFields = !payrollBlocked && (!bulletin || ['draft', 'generated', 'validated', 'closed'].includes(bulletinStatus));
    const statusLabel = {
        draft: 'Brouillon',
        generated: 'Brouillon',
        validated: 'Validé',
        closed: 'Clôturé',
    }[bulletinStatus] || bulletinStatus;
    const employeeStatusLabel = !emp.actif ? 'Inactif · Bloqué' : statusLabel;
    const employeeName = emp.nomComplet;
    const dateValue = value => value ? new Date(value).toLocaleDateString('fr-MA') : '—';
    const money = value => `${fmt(value)} DH`;
    const percent = value => value === undefined || value === null || Number.isNaN(Number(value))
        ? '—'
        : `${fmt(Number(value) * 100)}%`;
    const representationLabel = String(emp.indemniteRepresentationName || '').trim().toLowerCase();
    const representationRate = line => {
        if (!representationLabel || String(line.label || '').trim().toLowerCase() !== representationLabel) return null;
        if (values.indemniteNonImposableRate !== undefined && values.indemniteNonImposableRate !== null) {
            return values.indemniteNonImposableRate;
        }
        const base = Number(values.baseSalary || 0);
        return base > 0 ? Number(line.amount || 0) / base : null;
    };
    const primes = values.variablePrimes || [];
    const taxableAdditions = (values.taxableAdditions || []).filter(line => !String(line.calculationKey || '').startsWith('overtime_'));
    const fixedPrimeKeys = new Set((emp.bonuses || [])
        .filter(item => item.bonus ? item.bonus.taxable : item.taxable)
        .map(item => `${String(item.bonus ? item.bonus.name : item.name || '').toLowerCase()}|${Number(item.amount)}`));
    const nimpLines = bulletin ? (bulletin.fixedNimpLines || []) : (values.nimpLines || []);
    const monthlyNimpLines = bulletin ? (bulletin.monthlyNimpLines || []) : [];
    const manualRetenus = bulletin ? (bulletin.retenus || []) : [];
    const excludedNimpLines = bulletin ? (bulletin.excludedNimpLines || []) : [];
    const annual = annualCumulative || values.annualCumulative || {};
    const isPaidLeaveRubrique = row => {
        const key = String(row?.calculationKey || '').toLowerCase();
        const name = String(row?.name || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        return key === 'paid_leave' || key === 'paid_leave_days' || name.includes('conge');
    };
    const catalogueRubriques = (taxableRubriques || []).filter(row => row.active !== false && !isPaidLeaveRubrique(row) && !String(row.calculationKey || '').startsWith('overtime_'));
    const cataloguePrimeLines = catalogueRubriques.map(definition => {
        const existing = primes.find(prime => Number(prime.rubriqueImposableId) === Number(definition.id)
            || String(prime.label || '').trim().toLowerCase() === String(definition.name || '').trim().toLowerCase());
        return { definition, amount: existing ? Number(existing.amount || 0) : 0 };
    });
    const cataloguePrimeLabels = new Set(cataloguePrimeLines.map(line => line.definition.name.trim().toLowerCase()));
    const manualPrimes = primes.filter(prime => !cataloguePrimeLabels.has(String(prime.label || '').trim().toLowerCase()));
    const overtimeRows = [
        ['heuresSup25', 'overtime_25', 'Heures supplémentaires 25%', 1.25],
        ['heuresSup50', 'overtime_50', 'Heures supplémentaires 50%', 1.5],
        ['heuresSup100', 'overtime_100', 'Heures supplémentaires 100%', 2],
    ].map(([field, key, fallbackName, multiplier]) => ({
        field,
        definition: (taxableRubriques || []).find(row => row.calculationKey === key),
        fallbackName,
        amount: Number((Number(values[field] || 0) * Number(values.baseSalary || emp.baseSalary || 0) / standardMonthlyHours * multiplier).toFixed(2)),
    }));
    const taxablePaidLeaveDefinition = (taxableRubriques || []).find(row => row.active !== false && isPaidLeaveRubrique(row));
    const paidLeaveDefinition = taxablePaidLeaveDefinition || (typeof paidLeaveRubrique !== 'undefined' ? paidLeaveRubrique : null);
    const publicHolidayDefinition = typeof publicHolidayRubrique !== 'undefined' ? publicHolidayRubrique : null;
    const arrondi = Number(values.arrondi || 0);
    const totalGains = Number(values.sbg || 0) + Math.max(0, arrondi);
    const totalDeductions = Number(values.cnss || 0)
        + Number(values.amo || 0)
        + Number(values.cimr || 0)
        + Number(values.irNet || 0)
        + Number(values.avanceDeduction || 0)
        + Number(values.manualRetenusTotal || manualRetenus.reduce((sum, row) => sum + Number(row.amount || 0), 0))
        + Math.max(0, -arrondi);
    const totalAvanceSolde = (employeeAvances || []).reduce((sum, avance) => sum + Number(avance.solde || 0), 0);
    // A saved bulletin owns its deduction amount, including an explicit 0.
    // The available advance balance is only the initial value for a preview.
    const avanceInputValue = bulletin?.avanceDeductionConfigured ? Number(values.avanceDeduction || 0) : totalAvanceSolde;
%>

<% if (month && year) { %>
<div class="bulletin-workspace" id="bulletin-workspace">
<aside class="bulletin-employee-panel" id="bulletin-employee-panel" aria-label="Employés de la période" data-period="<%= month %>-<%= year %>">
    <div class="bulletin-employee-panel-header">
        <div>
            <span class="bulletin-panel-eyebrow">PÉRIODE</span>
            <h2>Employés</h2>
        </div>
        <button type="button" class="bulletin-panel-toggle" id="bulletin-panel-toggle" aria-controls="bulletin-employee-list" aria-expanded="true" title="Réduire la liste">‹</button>
    </div>
    <div class="bulletin-panel-body">
        <label class="bulletin-employee-search">
            <span class="sr-only">Rechercher un employé</span>
            <input id="bulletin-employee-search" type="search" placeholder="Nom ou matricule" autocomplete="off">
        </label>
        <div class="bulletin-employee-list" id="bulletin-employee-list" role="list">
            <% bulletinEmployees.forEach(employee => { %>
                <% const isCurrent = Number(employee.id) === Number(emp.id); %>
                <% const isValidated = ['VALIDATED', 'CLOSED'].includes(employee.status); %>
                <a class="bulletin-employee-link <%= isCurrent ? 'is-current' : '' %>" href="/bulletins/<%= employee.id %>?month=<%= month %>&year=<%= year %>" data-employee-id="<%= employee.id %>" data-search="<%= `${employee.nomComplet} ${employee.matricule}`.toLowerCase() %>" role="listitem" aria-current="<%= isCurrent ? 'page' : 'false' %>">
                    <span class="bulletin-employee-dot <%= isValidated ? 'is-validated' : 'is-draft' %>" title="<%= isValidated ? 'Validé' : 'Brouillon' %>" aria-label="<%= isValidated ? 'Validé' : 'Brouillon' %>"></span>
                    <span class="bulletin-employee-copy">
                        <strong><%= employee.nomComplet %></strong>
                        <small><%= employee.matricule || 'Sans matricule' %></small>
                    </span>
                    <% if (employee.netAPayer !== null) { %><span class="bulletin-employee-net"><%= fmt(employee.netAPayer) %> DH</span><% } %>
                </a>
            <% }); %>
            <% if (!bulletinEmployees.length) { %><p class="bulletin-employee-empty">Aucun employé dans cette période.</p><% } %>
        </div>
        <p class="bulletin-employee-no-results" id="bulletin-employee-no-results" hidden>Aucun résultat.</p>
    </div>
</aside>

<div
    class="payroll-print"
    data-employee-id="<%= emp.id %>"
    data-month="<%= month || '' %>"
    data-year="<%= year || '' %>"
    data-saved="<%= Boolean(bulletin) %>"
    data-locked="<%= locked %>">
    <% if (month && year) {
    %>
        <% if (!emp.actif) { %>
            <p class="bulletin-status" role="status" style="border-color:#f87171;border-left-color:#b42318;background:#fff1f2;color:#991b1b;"><strong>Statut : Inactif · Bloqué</strong><span style="color:#991b1b;">Cet employé est inactif. Le bulletin est affiché en lecture seule.</span></p>
        <% } else if (!bulletin) { %>
            <p class="bulletin-status" role="status">Aucun bulletin enregistré pour cette période. Les montants affichés sont un aperçu calculé avec les données actuelles.</p>
        <% } %>
    <% } %>
    <form id="payroll-form" method="POST" action="/bulletins/<%= emp.id %>/generate">
        <input type="hidden" name="month" value="<%= month || '' %>">
        <input type="hidden" name="year" value="<%= year || '' %>">
        <input type="hidden" name="paidLeaveDays" value="<%= values.paidLeaveDays ?? 0 %>" id="paid-leave-days-value">
        <input type="hidden" name="joursFeries" value="<%= values.joursFeries ?? 0 %>" id="jours-feries-value">

        <span id="primes"></span>
        <div class="print-actions">
            <a class="print-button return-action" href="/bulletins">Retour</a>
            <% if (bulletin) { %>
                <a class="print-button bulletin-action primary" href="/bulletins/<%= emp.id %>/pdf?month=<%= month %>&year=<%= year %>">Télécharger le PDF</a>
            <% } %>
            <% if (bulletin && !payrollBlocked && ['draft', 'generated'].includes(bulletinStatus)) { %>
                <button class="print-button bulletin-action primary" type="submit" formaction="/bulletins/<%= emp.id %>/validate">Valider</button>
            <% } else if (bulletinStatus === 'validated') { %>
                <button class="print-button bulletin-action" type="submit" formaction="/bulletins/<%= emp.id %>/draft">Retourner en brouillon</button>
                <button class="print-button bulletin-action primary close-action" type="submit" formaction="/bulletins/<%= emp.id %>/close" data-confirm="Êtes-vous sûr de vouloir clôturer le bulletin de <%= employeeName %> pour <%= monthName %> <%= year %> ?" data-confirm-title="Clôturer ce bulletin" data-confirm-label="Oui, clôturer" data-confirm-danger="true">Clôturer</button>
            <% } %>
            <% if (previousBulletinUrl) { %>
                <a class="print-button bulletin-action" href="<%= previousBulletinUrl %>" title="Bulletin précédent : <%= previousEmployee.nomComplet %>">Précédents</a>
            <% } else { %>
                <button class="print-button bulletin-action" type="button" disabled title="Premier employé de la liste">Précédents</button>
            <% } %>
            <% if (nextBulletinUrl) { %>
                <a class="print-button bulletin-action" href="<%= nextBulletinUrl %>" title="Bulletin suivant : <%= nextEmployee.nomComplet %>">Suivant</a>
            <% } else { %>
                <button class="print-button bulletin-action" type="button" disabled title="Dernier employé de la liste">Suivant</button>
            <% } %>
            <span class="save-confirmation" id="save-confirmation" role="status" aria-live="polite" hidden>Enregistré</span>
        </div>

        <% if (bulletin) { %>
            <div class="bulletin-status" role="status" aria-live="polite">
                <strong>Statut : <%= employeeStatusLabel %></strong>
                <% if (bulletinStatus === 'validated') { %>
                    <span>Bulletin en lecture seule. Retournez en brouillon pour modifier les données de paie.</span>
                <% } else if (closed) { %>
                    <span>Bulletin clôturé et verrouillé. Seules les indemnités non imposables peuvent être ajoutées, modifiées ou supprimées.</span>
                <% } else { %>
                    <span>Les données du bulletin sont modifiables.</span>
                <% } %>
            </div>
        <% } %>

        <div class="print-title">Traitement De Paie — <%= monthName %> <%= year %></div>

        <div class="employee-info">
            <div class="item">
                <span class="label">NOM &amp; PRÉNOM</span>
                <%= employeeName %>
            </div>
            <div class="item">
                <span class="label">MATRICULE</span>
                <%= emp.matricule || '—' %>
            </div>
            <div class="item">
                <span class="label">N° CNSS</span>
                <%= emp.numeroCNSS || '—' %>
            </div>
            <div class="item">
                <span class="label">FONCTION</span>
                <%= emp.employeeFunction ? emp.employeeFunction.name : '—' %>
            </div>
            <div class="item">
                <span class="label">N° CIN</span>
                <%= emp.cin || '—' %>
            </div>
            <div class="item">
                <span class="label">DATE D'ENTRÉE</span>
                <%= dateValue(emp.dateEmbauche) %>
            </div>
            <div class="item">
                <span class="label">SITUATION FAMILIALE</span>
                <%= emp.situationFam || '—' %>
            </div>
            <div class="item">
                <span class="label">NOMBRE DE PERSONNES À CHARGE</span>
                <%= emp.nbPersonacharge ?? 0 %>
            </div>
        </div>

        <br>

        <div class="print-actions">
            <% if (!locked) { %>
                <button type="button" class="add-prime" id="add-prime">+ Prime imposable</button>
            <% } %>
            <% if (canManageIndemnity) { %>
                <button type="button" class="add-prime" id="add-indemnity">+ Indemnité non imposable</button>
            <% } %>
        </div>
        <span id="indemnites"></span>

        <table class="pay-table">
            <thead>
                <tr>
                    <th style="width:9%">RUB</th>
                    <th style="width:24%">LIBELLÉS</th>
                    <th>NBR / BASE</th>
                    <th>TAUX</th>
                    <th>GAINS</th>
                    <th>RETENUES</th>
                    <th>COTIS. PATR.</th>
                </tr>
            </thead>
            <tbody id="prime-lines">
                <tr>
                        <td class="rubrique-code"><%= rubriqueCodes['Salaire de base'] || '' %></td><td class="description">Salaire de base</td>
                        <td class="num">
                        <% if (workingTimeMode === 'HOURS') { %>
                            <input class="employee-edit live-input working-time-primary" name="workedHours" aria-label="Nombre d'heures travaillées" title="Tab ou Entrée pour enregistrer" type="number" min="0" max="<%= standardMonthlyHours %>" step="1" required value="<%= values.workedHours ?? standardMonthlyHours %>" <%= locked ? 'disabled' : '' %>>
                            <small class="working-time-unit">h</small>
                        <% } else { %>
                            <input class="employee-edit live-input working-time-primary" name="workedDays" aria-label="Nombre de jours travaillés" title="Tab ou Entrée pour enregistrer" type="number" min="0" max="<%= standardMonthlyDays %>" step="1" required value="<%= values.workedDays ?? standardMonthlyDays %>" <%= locked ? 'disabled' : '' %>>
                            <small class="working-time-unit">j</small>
                        <% } %>
                    </td>
                    <td class="num">—</td>
                    <td class="num">
                        <span data-result="baseSalary"><%= fmt(values.baseSalary ?? emp.baseSalary) %></span>
                    </td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <tr class="seniority-row">
                    <td class="rubrique-code"><%= rubriqueCodes["Prime d'ancienneté"] || '' %></td><td class="description">Prime d'ancienneté</td>
                    <td class="num" data-result="baseSalary"><%= fmt(values.baseSalary ?? emp.baseSalary) %></td>
                    <td class="num"><%= percent(values.ancienneteRate) %></td>
                    <td class="num" data-result="primeAnciennete"><%= fmt(values.primeAnciennete) %></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <% cataloguePrimeLines.forEach(line => { %>
                    <tr class="prime-row taxable-prime-line catalogue-rubrique-line" data-rubrique-imposable-id="<%= line.definition.id %>">
                        <td class="rubrique-code"><%= line.definition.code || '' %></td>
                        <td class="description"><input name="primesLabels" value="<%= line.definition.name %>" readonly></td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num"><input class="live-input catalogue-rubrique-amount" name="primesAmounts" type="number" min="0" step="0.01" value="<%= line.amount %>" placeholder="0,00 DH" <%= locked ? 'disabled' : '' %>></td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                    </tr>
                <% }); %>
                <% manualPrimes.forEach(prime => { %>
                    <% const fixedPrime = !prime.rubriqueImposableId && fixedPrimeKeys.has(`${String(prime.label).toLowerCase()}|${Number(prime.amount)}`); %>
                    <tr class="prime-row taxable-prime-line <%= prime.rubriqueImposableId ? 'catalogue-rubrique-line' : '' %>" data-rubrique-imposable-id="<%= prime.rubriqueImposableId || '' %>">
                        <td class="rubrique-code"><%= prime.code || '' %></td><td class="description">
                            <input name="primesLabels" value="<%= prime.label %>" placeholder="Nom de la prime" <%= locked ? 'disabled' : '' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num">
                            <input class="live-input catalogue-rubrique-amount" name="primesAmounts" type="number" min="0" step="0.01" value="<%= prime.amount %>" placeholder="Montant DH" <%= locked ? 'disabled' : '' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">
                            <% if (!locked && !fixedPrime) { %>
                                <button type="button" class="remove-prime" aria-label="Supprimer la prime">×</button>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                <% taxableAdditions.forEach(line => { %>
                    <tr class="prime-row taxable-prime-line calculated-taxable-line">
                        <td class="rubrique-code"><%= line.code %></td><td class="description"><%= line.label %></td>
                        <td class="num">—</td><td class="num">—</td>
                        <td class="num"><%= fmt(line.amount) %></td><td class="num">—</td><td class="num">—</td>
                    </tr>
                <% }); %>
                <tr class="prime-row paid-leave-row">
                    <td class="rubrique-code"><%= paidLeaveDefinition?.code || '' %></td>
                    <td class="description"><%= paidLeaveDefinition?.name || 'Nombre jours congé payé' %></td>
                    <td class="num"><input class="live-input paid-leave-row-input" type="number" min="0" max="26" step="1" value="<%= values.paidLeaveDays ?? 0 %>" aria-label="Nombre entier de jours de congé payé" <%= locked ? 'disabled' : '' %>><small class="paid-leave-base">Base congé : <output data-result="baseConge"><%= fmt(values.baseConge ?? 0) %></output></small></td>
                    <td class="num">—</td>
                    <td class="num"><output data-result="paidLeaveAmount"><%= fmt(values.paidLeaveAmount ?? 0) %></output></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <tr class="prime-row public-holiday-row">
                    <td class="rubrique-code"><%= publicHolidayDefinition?.code || rubriqueCodes['Nombre jours fériés'] || '' %></td>
                    <td class="description"><%= publicHolidayDefinition?.name || 'Nombre jours fériés' %></td>
                    <td class="num"><input class="live-input public-holiday-row-input" type="number" min="0" max="26" step="1" value="<%= values.joursFeries ?? 0 %>" aria-label="Nombre entier de jours fériés" <%= locked ? 'disabled' : '' %>><small class="paid-leave-base">Base férié : <output data-result="baseFerie"><%= fmt(values.baseFerie ?? 0) %></output></small></td>
                    <td class="num">—</td>
                    <td class="num"><output data-result="joursFeriesAmount"><%= fmt(values.joursFeriesAmount ?? 0) %></output></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <% overtimeRows.forEach(row => { %>
                    <tr class="prime-row overtime-row">
                        <td class="rubrique-code"><%= row.definition?.code || '' %></td>
                        <td class="description"><%= row.definition?.name || row.fallbackName %></td>
                        <td class="num"><input class="live-input overtime-hours-row-input" name="<%= row.field %>" type="number" min="0" step="0.01" value="<%= values[row.field] ?? 0 %>" aria-label="<%= row.fallbackName %>" <%= locked ? 'disabled' : '' %>></td>
                        <td class="num">—</td>
                        <td class="num"><span data-overtime-amount="<%= row.field %>" data-overtime-multiplier="<%= row.definition?.calculationKey === 'overtime_25' ? 1.25 : row.definition?.calculationKey === 'overtime_50' ? 1.5 : 2 %>"><%= fmt(row.amount) %></span></td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                    </tr>
                <% }); %>
                <tr class="gross" id="taxable-gross-row">
                    <td class="rubrique-code"><%= rubriqueCodes['Salaire brut imposable'] || '' %></td><td colspan="3" class="description">SALAIRE BRUT IMPOSABLE <br></td>
                    <td class="num"><span data-result="sbi"><%= fmt(values.sbi) %></span></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>

                <tr>
                    <td class="rubrique-code"><%= rubriqueCodes.CNSS || '' %></td><td class="description">CNSS </td>
                    <td class="num" data-result="cnssBase"><%= fmt(Math.min(values.sbi, 6000)) %></td>
                    <td class="num"><%= percent(values.cnssRate) %></td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="cnss"><%= fmt(values.cnss) %></span></td>
                    <td class="num" data-result="cnssPatronale"><%= fmt(values.cnssPatronale) %></td>
                </tr>
                <tr>
                    <td class="rubrique-code"><%= rubriqueCodes.AMO || '' %></td><td class="description">AMO </td>
                    <td class="num" data-result="sbi"><%= fmt(values.sbi) %></td>
                    <td class="num"><%= percent(values.amoRate) %></td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="amo"><%= fmt(values.amo) %></span></td>
                    <td class="num" data-result="amoPatronale"><%= fmt(values.amoPatronale) %></td>
                </tr>
                <tr>
                    <td class="rubrique-code"><%= rubriqueCodes.CIMR || '' %></td><td class="description">CIMR </td>
                    <td class="num" data-result="sbi"><%= fmt(values.sbi) %></td>
                    <td class="num"><%= percent(values.cimrRate) %></td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="cimr"><%= fmt(values.cimr) %></span></td>
                    <td class="num">—</td>
                </tr>
                <% manualRetenus.forEach(row => { %>
                    <tr class="manual-retenu-row">
                        <td class="rubrique-code"><%= row.code %></td><td class="description"><%= row.label %></td>
                        <td class="num">—</td><td class="num">—</td><td class="num">—</td>
                        <td class="num"><%= fmt(row.amount) %></td><td class="num"><form method="POST" action="/bulletins/<%= emp.id %>/retenus/delete" class="inline-delete-form"><input type="hidden" name="retenuId" value="<%= row.id %>"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="year" value="<%= year %>"><button class="remove-prime" type="submit" aria-label="Supprimer la retenue">×</button></form></td>
                    </tr>
                <% }); %>
                <tr>
                    <td class="rubrique-code"><%= rubriqueCodes['Frais professionnels'] || '' %></td><td class="description" title="Déduction utilisée pour calculer le revenu imposable.">Frais professionnels (déduction fiscale)</td>
                    <td class="num" data-result="sbi"><%= fmt(values.sbi) %></td>
                    <td class="num" data-result="fraisProRate"><%= percent(values.fraisProRate) %></td>
                    <td class="num">—</td>
                    <td class="num" data-result="fraisPro"><%= fmt(values.fraisPro) %></td>
                    <td class="num">—</td>
                </tr>

                <tr class="gross">
                    <td class="rubrique-code"><%= rubriqueCodes['Salaire net imposable'] || '' %></td><td class="description">SNI / IR</td>
                    <td class="num"><span data-result="sni"><%= fmt(values.sni) %></span></td>
                    <td class="num" data-result="irTaux"><%= percent(values.irTaux) %></td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="irNet"><%= fmt(values.irNet) %></span></td>
                    <td class="num">—</td>
                </tr>
        <% if (totalAvanceSolde > 0 || Number(values.avanceDeduction || 0) > 0) { %>
                <tr class="manual-retenu-row avance-deduction-row">
                    <td class="rubrique-code">AV</td><td class="description">Avance sur salaire</td>
                    <td class="num">—</td><td class="num">—</td><td class="num">—</td>
                    <td class="num">
                        <% if (bulletin && !locked) { %>
                            <input class="live-input avance-deduction-input" name="avanceDeduction" type="number" min="0" step="0.01" max="<%= (bulletin ? totalAvanceSolde + Number(values.avanceDeduction || 0) : totalAvanceSolde).toFixed(2) %>" value="<%= avanceInputValue.toFixed(2) %>" data-saved-value="<%= avanceInputValue.toFixed(2) %>" title="Tab, Entrée ou clic ailleurs pour enregistrer" aria-label="Montant de l'avance à retenir">
                        <% } else { %><%= fmt(values.avanceDeduction || 0) %><% } %>
                    </td>
                    <td class="num">—</td>
                </tr>
                <% } %>
                <tr>
                    <td class="rubrique-code"><%= rubriqueCodes.Arrondi || '' %></td><td class="description">ARRONDI</td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="arrondiGains"><%= arrondi > 0 ? fmt(arrondi) : '—' %></span></td>
                    <td class="num"><span data-result="arrondiRetenues"><%= arrondi < 0 ? fmt(Math.abs(arrondi)) : '—' %></span></td>
                    <td class="num">—</td>
                </tr>

                <% nimpLines.forEach(line => { const baseAmount = Number(line.baseAmount ?? line.amount); %>
                    <tr class="disabled-row fixed-indemnity-line monthly-indemnity-line" data-sticky="true">
                        <td class="rubrique-code"><%= line.code || '' %></td><td class="description">
                            <input class="live-input" name="nimpLabels" data-original-label="<%= line.label %>" data-original-amount="<%= baseAmount %>" value="<%= line.label %>" placeholder="Libellé de l'indemnité" <%= canEditIndemnityFields ? '' : 'disabled' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num"><%= percent(representationRate(line)) %></td>
                        <td class="num"><input class="live-input" name="nimpAmounts" data-original-label="<%= line.label %>" data-original-amount="<%= baseAmount %>" type="number" min="0" step="0.01" value="<%= baseAmount %>" placeholder="Montant mensuel DH" <%= canEditIndemnityFields ? '' : 'disabled' %>><small class="nimp-payable">Payable : <span data-nimp-payable><%= money(line.amount) %></span></small></td>
                        <td class="num">—</td>
                        <td class="num">
                            <% if (canManageIndemnity) { %><button type="button" class="remove-prime" aria-label="Supprimer l'indemnité">×</button><% } else { %>—<% } %>
                        </td>
                    </tr>
                <% }); %>
                <% monthlyNimpLines.forEach(line => { const baseAmount = Number(line.baseAmount ?? line.amount); %>
                    <tr class="monthly-indemnity-row prime-row monthly-indemnity-line">
                        <td class="rubrique-code"><%= line.code || '' %></td><td class="description">
                            <input class="live-input" name="nimpLabels" data-original-label="<%= line.label %>" data-original-amount="<%= baseAmount %>" value="<%= line.label %>" placeholder="Libellé de l'indemnité" <%= canEditIndemnityFields ? '' : 'disabled' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num">
                            <input class="live-input" name="nimpAmounts" data-original-label="<%= line.label %>" data-original-amount="<%= baseAmount %>" type="number" min="0" step="0.01" value="<%= baseAmount %>" placeholder="Montant mensuel DH" <%= canEditIndemnityFields ? '' : 'disabled' %>><small class="nimp-payable">Payable : <span data-nimp-payable><%= money(line.amount) %></span></small>
                        </td>
                        <td class="num">—</td>
                        <td class="num">
                            <% if (canManageIndemnity) { %>
                                <button type="button" class="remove-prime" aria-label="Supprimer l'indemnité">×</button>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                <tr class="gross totals-row">
                    <td class="rubrique-code"></td><td colspan="3" class="description">TOTAUX</td>
                    <td class="num"><span data-result="totalGains"><%= money(totalGains) %></span></td>
                    <td class="num"><span data-result="deductionsTotal"><%= money(totalDeductions) %></span></td>
                    <td class="num">—</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="7" class="net-pay-cell">
                        <div class="net-pay-callout-content">
                            <span class="net-pay-callout-label">SALAIRE NET À PAYER</span>
                            <span class="net-pay-callout-value" data-result="netAPayer"><%= money(values.netAPayer) %></span>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>

        <section class="annual-cumulative" aria-labelledby="annual-cumulative-title">
            <div class="annual-cumulative-header">
                <h2 id="annual-cumulative-title">Cumul annuel <%= year %></h2>
                <p class="annual-cumulative-note">Bulletin courant inclus · données officielles de l'exercice</p>
            </div>
            <div class="annual-cumulative-grid">
                <div class="annual-cumulative-item" title="Nombre de bulletins cumulés dans l'année, bulletin courant inclus">
                    <span>Période</span>
                    <strong data-result="periode"><%= periode %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Jours travaillés</span>
                    <strong data-result="annualWorkedDays"><%= Number(annual.workedDays || 0).toLocaleString('fr-MA') %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Heures travaillées</span>
                    <strong data-result="annualWorkedHours"><%= Number(annual.workedHours || 0).toLocaleString('fr-MA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Salaire brut imposable (SBI)</span>
                    <strong data-result="annualSbi"><%= money(annual.sbi) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Brut global</span>
                    <strong data-result="annualBrutGlobal"><%= money(annual.brutGlobal) %></strong>
                </div>

                <div class="annual-cumulative-item">
                    <span>IR </span>
                    <strong data-result="annualIrNet"><%= money(annual.irNet) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>CNSS salariale</span>
                    <strong data-result="annualCnss"><%= money(annual.cnss) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>AMO salariale</span>
                    <strong data-result="annualAmo"><%= money(annual.amo) %></strong>
                </div>
            </div>
        </section>

        <div id="calculation-state" aria-live="polite"></div>
        <div id="calculation-error" hidden></div>

        <% if (bulletin && !locked && (manualRetenuRubriques || []).length) { %>
        <% } %>
        <div class="print-note">Document généré automatiquement. SBG - indemnités non imposablesLes montants sont calculés selon les données de l'employé et la période sélectionnée.</div>
    </form>

    <% if (!locked || canManageIndemnity) { %>
        <% if (!locked) { %>
            <dialog class="prime-dialog" id="prime-dialog">
            <form method="dialog" id="prime-dialog-form" class="prime-dialog-content">
                <h2>Ajouter une prime imposable</h2>
                <p>Choisissez une prime du catalogue ou saisissez-en une nouvelle.</p>
                <div class="prime-dialog-fields">
                    <label>
                        Prime existante
                        <select id="prime-rubrique-select" class="form-input">
                            <option value="">Nouvelle prime</option>
                            <% (availablePrimes || []).forEach(prime => { %>
                                <option value="<%= prime.id %>" data-code="<%= prime.code %>" data-name="<%= prime.name %>" data-amount="<%= prime.defaultAmount %>"><%= prime.code %> — <%= prime.name %></option>
                            <% }); %>
                        </select>
                    </label>
                    <label>
                        Code rubrique
                        <input id="prime-code-input" required placeholder="Ex. 3001">
                    </label>
                    <label>
                        Nom de la prime
                        <input id="prime-label-input" required placeholder="Ex. Prime de rendement">
                    </label>
                    <label>
                        Montant en DH
                        <input id="prime-amount-input" required type="number" min="0.01" step="0.01" placeholder="Ex. 1 000,00">
                    </label>
                </div>
                <div class="prime-dialog-actions">
                    <button type="button" id="prime-dialog-cancel">Annuler</button>
                    <button type="button" id="prime-save-catalogue">Ajouter au catalogue</button>
                    <button class="confirm" value="add" type="submit">Ajouter la prime</button>
                </div>
            </form>
            </dialog>

            <dialog class="prime-dialog" id="overtime-dialog">
                <form method="dialog" id="overtime-dialog-form" class="prime-dialog-content">
                    <h2 id="overtime-dialog-title">Ajouter des heures supplémentaires</h2>
                    <p>Le montant sera calculé automatiquement selon le salaire horaire de l’employé.</p>
                    <div class="prime-dialog-fields">
                        <label>
                            Type d’heures supplémentaires
                            <select id="overtime-type-select" class="form-input" required>
                                <option value="heuresSup25">Heures supplémentaires 25%</option>
                                <option value="heuresSup50">Heures supplémentaires 50%</option>
                                <option value="heuresSup100">Heures supplémentaires 100%</option>
                            </select>
                        </label>
                        <label>
                            Nombre d’heures
                            <input id="overtime-hours-input" required type="number" min="0.01" step="0.01" placeholder="Ex. 8">
                        </label>
                    </div>
                    <div class="prime-dialog-actions">
                        <button type="button" id="overtime-dialog-cancel">Annuler</button>
                        <button class="confirm" value="add" type="submit">Ajouter</button>
                    </div>
                </form>
            </dialog>

        <% } %>

        <dialog class="prime-dialog" id="indemnity-dialog">
            <form method="dialog" id="indemnity-dialog-form" class="prime-dialog-content">
                <h2>Ajouter une indemnité non imposable</h2>
                <p>Choisissez une indemnité du catalogue ou saisissez-en une nouvelle.</p>
                <% if (canManageIndemnity && excludedNimpLines.length) { %>
                    <div class="restore-indemnity-list">
                        <strong>Remettre une indemnité supprimée</strong>
                        <% excludedNimpLines.forEach(line => { %>
                            <button type="button" class="restore-indemnity" data-label="<%= line.label %>">Remettre cette indemnité : <%= line.label %></button>
                        <% }); %>
                    </div>
                <% } %>
                <div class="prime-dialog-fields">
                    <label>
                        Indemnité existante
                        <select id="indemnity-catalogue-select" class="form-input">
                            <option value="">Nouvelle indemnité</option>
                            <% (availableIndemnites || []).forEach(indemnity => { %>
                                <option value="<%= indemnity.id %>" data-code="<%= indemnity.code %>" data-name="<%= indemnity.name %>" data-amount="<%= indemnity.defaultAmount %>"><%= indemnity.code %> — <%= indemnity.name %></option>
                            <% }); %>
                        </select>
                    </label>
                    <label>
                        Code rubrique
                        <input id="indemnity-code-input" required placeholder="Ex. 2001">
                    </label>
                    <label>
                        Libellé de l'indemnité
                        <input id="indemnity-label-input" required placeholder="Ex. Indemnité de transport">
                    </label>
                    <label>
                        Montant en DH
                        <input id="indemnity-amount-input" required type="number" min="0.01" step="0.01" placeholder="Ex. 500,00">
                    </label>
                </div>
                <div class="prime-dialog-actions">
                    <button type="button" id="indemnity-dialog-cancel">Annuler</button>
                    <button type="button" id="indemnity-save-catalogue">Ajouter au catalogue</button>
                    <button class="confirm" value="add" type="submit">Ajouter l'indemnité</button>
                </div>
            </form>
        </dialog>


    <% } %>
</div>
<% } %></div>
<script src="/js/show-bulletin.js"></script>
<%- include('../partials/footer') %>
                
