        border-radius: 5px;
        background: #fff;
        color: #25313c;
        font: 600 13px "Segoe UI", Arial, sans-serif;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
    }

    .payroll-print .print-button:hover,
    .payroll-print .add-prime:hover {
        border-color: var(--accent);
        background: #f0f8f6;
        color: var(--accent-dark);
    }

    .payroll-print .print-button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
    }

    .payroll-print .print-button.primary:hover {
        border-color: var(--accent-dark);
        background: var(--accent-dark);
    }

    .payroll-print .employee-info {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
    }

    .payroll-print .employee-info .item {
        min-height: 62px;
        padding: 12px 14px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        font-size: 15px;
    }

    .payroll-print .employee-info .label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
