<%
    const values = bulletin || previewResult || {};
    const bulletinStatus = bulletin?.status || 'draft';
    const payrollBlocked = Boolean(!emp.actif || emp.blocageSaisiePaie);
    const locked = payrollBlocked || Boolean(bulletin && ['validated', 'closed'].includes(bulletinStatus));
    const closed = bulletinStatus === 'closed';
    const canManageIndemnity = !payrollBlocked && (!bulletin || ['draft', 'generated', 'validated', 'closed'].includes(bulletinStatus));
    const canEditIndemnityFields = !payrollBlocked && (!bulletin || ['draft', 'generated', 'validated', 'closed'].includes(bulletinStatus));
    const statusLabel = {
        draft: 'Brouillon',
        generated: 'Brouillon',
        validated: 'Validé',
        closed: 'Clôturé',
    }[bulletinStatus] || bulletinStatus;
    const employeeStatusLabel = !emp.actif ? 'Inactif · Bloqué' : statusLabel;
    const employeeName = emp.nomComplet;
    const dateValue = value => value ? new Date(value).toLocaleDateString('fr-MA') : '—';
    const money = value => `${fmt(value)} DH`;
    const primes = values.variablePrimes || [];
    const fixedPrimeKeys = new Set((emp.bonuses || [])
        .filter(item => item.bonus ? item.bonus.taxable : item.taxable)
        .map(item => `${String(item.bonus ? item.bonus.name : item.name || '').toLowerCase()}|${Number(item.amount)}`));
    const nimpLines = bulletin ? (bulletin.fixedNimpLines || []) : (values.nimpLines || []);
    const monthlyNimpLines = bulletin ? (bulletin.monthlyNimpLines || []) : [];
    const annual = annualCumulative || values.annualCumulative || {};
    const arrondi = Number(values.arrondi || 0);
    const totalGains = Number(values.sbg || 0) + Math.max(0, arrondi);
    const totalDeductions = Number(values.cnss || 0)
        + Number(values.amo || 0)
        + Number(values.cimr || 0)
        + Number(values.irNet || 0)
        + Number(values.avances || 0)
        + Math.max(0, -arrondi);
%>

<div
    class="payroll-print"
    data-employee-id="<%= emp.id %>"
    data-month="<%= month || '' %>"
    data-year="<%= year || '' %>"
    data-saved="<%= Boolean(bulletin) %>"
    data-locked="<%= locked %>">
    <% if (month && year) {
    %>
        <% if (!emp.actif) { %>
            <p class="bulletin-status" role="status" style="border-color:#f87171;border-left-color:#b42318;background:#fff1f2;color:#991b1b;"><strong>Statut : Inactif · Bloqué</strong><span style="color:#991b1b;">Cet employé est inactif. Le bulletin est affiché en lecture seule.</span></p>
        <% } else if (!bulletin) { %>
            <p class="bulletin-status" role="status">Aucun bulletin enregistré pour cette période. Les montants affichés sont un aperçu calculé avec les données actuelles.</p>
        <% } %>
    <% } %>
    <form id="payroll-form" method="POST" action="/bulletins/<%= emp.id %>/generate">
        <input type="hidden" name="month" value="<%= month || '' %>">
        <input type="hidden" name="year" value="<%= year || '' %>">

        <div class="print-actions">
            <a class="print-button return-action" href="/bulletins">Retour</a>
            <% if (bulletin && !payrollBlocked && ['draft', 'generated'].includes(bulletinStatus)) { %>
                <button class="print-button bulletin-action primary" type="submit" formaction="/bulletins/<%= emp.id %>/validate">Valider</button>
            <% } else if (bulletinStatus === 'validated') { %>
                <button class="print-button bulletin-action" type="submit" formaction="/bulletins/<%= emp.id %>/draft">Retourner en brouillon</button>
                <button class="print-button bulletin-action primary close-action" type="submit" formaction="/bulletins/<%= emp.id %>/close" data-confirm="Êtes-vous sûr de vouloir clôturer le bulletin de <%= employeeName %> pour <%= monthName %> <%= year %> ?" data-confirm-title="Clôturer ce bulletin" data-confirm-label="Oui, clôturer" data-confirm-danger="true">Clôturer</button>
            <% } %>
            <% if (previousBulletinUrl) { %>
                <a class="print-button bulletin-action" href="<%= previousBulletinUrl %>" title="Bulletin précédent : <%= previousEmployee.nomComplet %>">Précédents</a>
            <% } else { %>
                <button class="print-button bulletin-action" type="button" disabled title="Premier employé de la liste">Précédents</button>
            <% } %>
            <% if (nextBulletinUrl) { %>
                <a class="print-button bulletin-action" href="<%= nextBulletinUrl %>" title="Bulletin suivant : <%= nextEmployee.nomComplet %>">Suivant</a>
            <% } else { %>
                <button class="print-button bulletin-action" type="button" disabled title="Dernier employé de la liste">Suivant</button>
            <% } %>
        </div>

        <% if (bulletin) { %>
            <div class="bulletin-status" role="status" aria-live="polite">
                <strong>Statut : <%= employeeStatusLabel %></strong>
                <% if (bulletinStatus === 'validated') { %>
                    <span>Bulletin en lecture seule. Retournez en brouillon pour modifier les données de paie.</span>
                <% } else if (closed) { %>
                    <span>Bulletin clôturé et verrouillé. Seules les indemnités non imposables peuvent être ajoutées, modifiées ou supprimées.</span>
                <% } else { %>
                    <span>Les données du bulletin sont modifiables.</span>
                <% } %>
            </div>
        <% } %>

        <div class="print-title">Traitement De Paie — <%= monthName %> <%= year %></div>

        <div class="employee-info">
            <div class="item">
                <span class="label">NOM &amp; PRÉNOM</span>
                <%= employeeName %>
            </div>
            <div class="item">
                <span class="label">MATRICULE</span>
                <%= emp.matricule || '—' %>
            </div>
            <div class="item">
                <span class="label">N° CNSS</span>
                <%= emp.numeroCNSS || '—' %>
            </div>
            <div class="item">
                <span class="label">FONCTION</span>
                <%= emp.fonction || '—' %>
            </div>
            <div class="item">
                <span class="label">N° CIN</span>
                <%= emp.cin || '—' %>
            </div>
            <div class="item">
                <span class="label">DATE D'ENTRÉE</span>
                <%= dateValue(emp.dateEmbauche) %>
            </div>
            <div class="item">
                <span class="label">SITUATION FAMILIALE</span>
                <%= emp.situationFam || '—' %>
            </div>
            <div class="item">
                <span class="label">NOMBRE DE PERSONNES À CHARGE</span>
                <%= emp.nbPersonacharge ?? 0 %>
            </div>
        </div>

        <br>

        <div class="print-actions">
            <% if (!locked) { %>
                <button type="button" class="add-prime" id="add-prime">+ Ajouter une prime imposable</button>
            <% } %>
            <% if (canManageIndemnity) { %>
                <button type="button" class="add-prime" id="add-indemnity">+ Ajouter une indemnité non imposable</button>
            <% } %>
        </div>


        <table class="pay-table">
            <thead>
                <tr>
                    <th style="width:28%">LIBELLÉS</th>
                    <th>NBR / BASE</th>
                    <th>TAUX</th>
                    <th>GAINS</th>
                    <th>RETENUES</th>
                    <th>COTIS. PATR.</th>
                </tr>
            </thead>
            <tbody id="prime-lines">
                <tr>
                    <td class="description">Salaire de base</td>
                    <td class="num">
                        <input class="employee-edit live-input" name="workedDays" aria-label="Nombre de jours travaillés" title="Tab ou Entrée pour enregistrer" type="number" min="0" max="26" step="1" required value="<%= values.workedDays ?? 26 %>" <%= locked ? 'disabled' : '' %>>
                    </td>
                    <td class="num">—</td>
                    <td class="num">
                        <span data-result="baseSalary"><%= fmt(values.baseSalary ?? emp.baseSalary) %></span>
                    </td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <tr class="seniority-row">
                    <td class="description">Prime d'ancienneté</td>
                    <td class="num" data-result="baseSalary"><%= fmt(values.baseSalary ?? emp.baseSalary) %></td>
                    <td class="num"><%= values.ancienneteRate ? `${fmt(values.ancienneteRate * 100)}%` : '—' %></td>
                    <td class="num" data-result="primeAnciennete"><%= fmt(values.primeAnciennete) %></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <% primes.forEach(prime => { %>
                    <% const fixedPrime = fixedPrimeKeys.has(`${String(prime.label).toLowerCase()}|${Number(prime.amount)}`); %>
                    <tr class="prime-row taxable-prime-line">
                        <td class="description">
                            <input name="primesLabels" value="<%= prime.label %>" placeholder="Nom de la prime" <%= locked ? 'disabled' : '' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num">
                            <input class="live-input" name="primesAmounts" type="number" min="0" step="0.01" value="<%= prime.amount %>" placeholder="Montant DH" <%= locked ? 'disabled' : '' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">
                            <% if (!locked && !fixedPrime) { %>
                                <button type="button" class="remove-prime" aria-label="Supprimer la prime">×</button>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                <tr class="gross">
                    <td colspan="3" class="description">SALAIRE BRUT IMPOSABLE <br></td>
                    <td class="num"><span data-result="sbi"><%= fmt(values.sbi) %></span></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>

                <tr>
                    <td class="description">CNSS </td>
                    <td class="num" data-result="cnssBase"><%= fmt(Math.min(values.sbi, 6000)) %></td>
                    <td class="num">4,48%</td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="cnss"><%= fmt(values.cnss) %></span></td>
                    <td class="num" data-result="cnssPatronale"><%= fmt(values.cnssPatronale) %></td>
                </tr>
                <tr>
                    <td class="description">AMO </td>
                    <td class="num" data-result="sbi"><%= fmt(values.sbi) %></td>
                    <td class="num">2,26%</td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="amo"><%= fmt(values.amo) %></span></td>
                    <td class="num" data-result="amoPatronale"><%= fmt(values.amoPatronale) %></td>
                </tr>
                <tr>
                    <td class="description">Avance sur salaire</td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                    <td class="num"><%= fmt(values.avances) %></td>
                    <td class="num">—</td>
                </tr>

                <tr>
                    <td class="description" title="Déduction utilisée pour calculer le revenu imposable.">Frais professionnels (déduction fiscale)</td>
                    <td class="num" data-result="sbi"><%= fmt(values.sbi) %></td>
                    <td class="num" data-result="fraisProRate"><%= fmt(Number(values.fraisProRate || 0) * 100) %>%</td>
                    <td class="num">—</td>
                    <td class="num" data-result="fraisPro"><%= fmt(values.fraisPro) %></td>
                    <td class="num">—</td>
                </tr>

                <tr class="gross">
                    <td colspan="3" class="description">SALAIRE NET IMPOSABLE (SNI)<br></td>
                    <td class="num"><span data-result="sni"><%= fmt(values.sni) %></span></td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                </tr>
                <tr class="gross">
                    <td colspan="3" class="description">IR<br></td>
                    <td class="num"></td>
                    <td class="num"><span data-result="irNet"><%= fmt(values.irNet) %></span></td>
                    <td class="num">—</td>
                </tr>
                <tr>
                    <td class="description">ARRONDI</td>
                    <td class="num">—</td>
                    <td class="num">—</td>
                    <td class="num"><span data-result="arrondiGains"><%= arrondi > 0 ? fmt(arrondi) : '—' %></span></td>
                    <td class="num"><span data-result="arrondiRetenues"><%= arrondi < 0 ? fmt(Math.abs(arrondi)) : '—' %></span></td>
                    <td class="num">—</td>
                </tr>

                <% nimpLines.forEach(line => { %>
                    <tr class="disabled-row">
                        <td class="description">
                            <%= line.label %> 
                            <input type="hidden" name="nimpLabels" value="<%= line.label %>">
                            <input type="hidden" name="nimpAmounts" value="<%= line.amount %>">
                        </td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num"><%= fmt(line.amount) %></td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                    </tr>
                <% }); %>
                <% monthlyNimpLines.forEach(line => { %>
                    <tr class="monthly-indemnity-row prime-row monthly-indemnity-line">
                        <td class="description">
                            <input class="live-input" name="nimpLabels" data-original-label="<%= line.label %>" data-original-amount="<%= line.amount %>" value="<%= line.label %>" placeholder="Libellé de l'indemnité" <%= canEditIndemnityFields ? '' : 'disabled' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">—</td>
                        <td class="num">
                            <input class="live-input" name="nimpAmounts" data-original-label="<%= line.label %>" data-original-amount="<%= line.amount %>" type="number" min="0" step="0.01" value="<%= line.amount %>" placeholder="Montant DH" <%= canEditIndemnityFields ? '' : 'disabled' %>>
                        </td>
                        <td class="num">—</td>
                        <td class="num">
                            <% if (canManageIndemnity) { %>
                                <button type="button" class="remove-prime" aria-label="Supprimer l'indemnité">×</button>
                            <% } else { %>
                                —
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                <tr class="gross totals-row">
                    <td colspan="3" class="description">TOTAUX</td>
                    <td class="num"><span data-result="totalGains"><%= money(totalGains) %></span></td>
                    <td class="num"><span data-result="deductionsTotal"><%= money(totalDeductions) %></span></td>
                    <td class="num">—</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="net-pay-cell">
                        <div class="net-pay-callout-content">
                            <span class="net-pay-callout-label">SALAIRE NET À PAYER</span>
                            <span class="net-pay-callout-value" data-result="netAPayer"><%= money(values.netAPayer) %></span>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>

        <section class="annual-cumulative" aria-labelledby="annual-cumulative-title">
            <div class="annual-cumulative-header">
                <h2 id="annual-cumulative-title">Cumul annuel <%= year %></h2>
                <p class="annual-cumulative-note">Bulletin courant inclus · données officielles de l'exercice</p>
            </div>
            <div class="annual-cumulative-grid">
                <div class="annual-cumulative-item" title="Nombre de bulletins cumulés dans l'année, bulletin courant inclus">
                    <span>Période</span>
                    <strong data-result="periode"><%= periode %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Jours travaillés</span>
                    <strong data-result="annualWorkedDays"><%= Number(annual.workedDays || 0).toLocaleString('fr-MA') %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>Salaire brut imposable (SBI)</span>
                    <strong data-result="annualSbi"><%= money(annual.sbi) %></strong>
                </div>
                
                <div class="annual-cumulative-item">
                    <span>IR </span>
                    <strong data-result="annualIrNet"><%= money(annual.irNet) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>CNSS salariale</span>
                    <strong data-result="annualCnss"><%= money(annual.cnss) %></strong>
                </div>
                <div class="annual-cumulative-item">
                    <span>AMO salariale</span>
                    <strong data-result="annualAmo"><%= money(annual.amo) %></strong>
                </div>
            </div>
        </section>

        <div id="calculation-state" aria-live="polite"></div>
        <div id="calculation-error" hidden></div>

        <div class="print-note">Document généré automatiquement. SBG - indemnités non imposablesLes montants sont calculés selon les données de l'employé et la période sélectionnée.</div>
    </form>

    <% if (!locked || canManageIndemnity) { %>
        <% if (!locked) { %>
            <dialog class="prime-dialog" id="prime-dialog">
            <form method="dialog" id="prime-dialog-form" class="prime-dialog-content">
                <h2>Ajouter une prime imposable</h2>
                <p>Cette prime sera ajoutée uniquement au bulletin du mois courant.</p>
                <div class="prime-dialog-fields">
                    <label>
                        Nom de la prime
                        <input id="prime-label-input" required placeholder="Ex. Prime de rendement">
                
                    <label>
                        Montant en DH
                        <input id="prime-amount-input" required type="number" min="0.01" step="0.01" placeholder="Ex. 1 000,00">
                    </label>
                </div>
                <div class="prime-dialog-actions">
                    <button type="button" id="prime-dialog-cancel">Annuler</button>
                    <button class="confirm" value="add" type="submit">Ajouter la prime</button>
                </div>
            </form>
            </dialog>
        <% } %>

        <dialog class="prime-dialog" id="indemnity-dialog">
            <form method="dialog" id="indemnity-dialog-form" class="prime-dialog-content">
                <h2>Ajouter une indemnité non imposable</h2>
                <p>Elle sera ajoutée uniquement au bulletin du mois courant, après l'IR.</p>
                <div class="prime-dialog-fields">
                    <label>
                        Libellé de l'indemnité
                        <input id="indemnity-label-input" required placeholder="Ex. Indemnité de transport">
                    </label>
                    <label>
                        Montant en DH
                        <input id="indemnity-amount-input" required type="number" min="0.01" step="0.01" placeholder="Ex. 500,00">
                    </label>
                </div>
                <div class="prime-dialog-actions">
                    <button type="button" id="indemnity-dialog-cancel">Annuler</button>
                    <button class="confirm" value="add" type="submit">Ajouter l'indemnité</button>
                </div>
            </form>
        </dialog>


    <% } %>
</div>
<script src="/js/show-bulletin.js"></script>
<%- include('../partials/footer') %>
                
