            font-variant-numeric: tabular-nums;
        }

    .payroll-print .annual-cumulative {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 6px;
        background: var(--soft);
    }

    .payroll-print .annual-cumulative-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .payroll-print .annual-cumulative h2 {
        margin: 0;
