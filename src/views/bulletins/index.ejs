<%- include('../partials/header') %>
<%
    const isRubriqueVisible = (category, key) => rubriqueVisibility?.[category]?.[String(key)] !== false;
    const isRubriqueColumnVisible = column => {
        if (overtimeEnabled === false && column.kind === 'overtime') return false;
        if (primeRendementEnabled === false && column.kind === 'primeRendement') return false;
        if (column.rubriqueVisibilityCategory && column.rubriqueVisibilityKey) {
            return isRubriqueVisible(column.rubriqueVisibilityCategory, column.rubriqueVisibilityKey);
        }
        return true;
    };
    const visibleRubriqueColumns = (rubriqueColumns || []).filter(isRubriqueColumnVisible);
%>
<% if (typeof bulletinPeriodMessage !== 'undefined' && bulletinPeriodMessage) { %>
    <div role="alert" id="bulletin-period-message" class="bulk-summary"><%= bulletinPeriodMessage %></div>
<% } %>
<% if (typeof bulletinError !== 'undefined' && bulletinError) { %>
    <div role="alert" id="bulletin-error-message" hidden><%= bulletinError %></div>
<% } %>

<form id="period-form" method="POST" action="/bulletins/close-bulk" hidden>
    <input type="hidden" name="month" value="<%= month %>">
    <input type="hidden" name="year" value="<%= year %>">
</form>

<div class="page-header">
    <div class="header-title-area">
        <h1 class="page-title">Traitement de paie</h1>
        <p class="page-subtitle">Gestion et génération des bulletins de salaire par période</p>
    </div>
    <div class="header-actions">
            <% if (employees.some(emp => emp.bulletin && emp.bulletin.status !== 'closed')) { %>
            <button type="submit" class="btn-primary close-action" form="period-form" formmethod="POST" formaction="/bulletins/close-bulk" data-confirm="Êtes-vous sûr de vouloir clôturer tous les bulletins de <%= monthName %> <%= year %> ?" data-confirm-title="Clôturer le mois" data-confirm-label="Oui, clôturer" data-confirm-danger="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Clôturer le mois
            </button>
            <% } %>
    </div>
</div>

<% if (bulkResult) { %>
<div class="bulk-summary">
    <div class="bulk-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
    </div>
    <div>
        Génération terminée —
        <strong><%= bulkResult.created %> bulletin<%= bulkResult.created > 1 ? 's' : '' %> créé<%= bulkResult.created > 1 ? 's' : '' %></strong>
        <% if (bulkResult.skipped > 0) { %>
            · <strong><%= bulkResult.skipped %></strong> ignoré<%= bulkResult.skipped > 1 ? 's' : '' %> (bulletin déjà existant)
        <% } %>
        <% if (bulkResult.errors && bulkResult.errors.length > 0) { %>
            · <strong style="color:#8b1a1a;"><%= bulkResult.errors.length %> erreur<%= bulkResult.errors.length > 1 ? 's' : '' %></strong>
        <% } %>
    </div>
</div>
<% } %>

<% if (typeof validateResult !== 'undefined' && validateResult) { %>
<div class="bulk-summary" role="status">
    <% if (validateResult.count > 0) { %>
        <strong><%= validateResult.count %> bulletin<%= validateResult.count > 1 ? 's' : '' %> validé<%= validateResult.count > 1 ? 's' : '' %> pour <%= monthNames[validateResult.month] %> <%= validateResult.year %>.</strong>
    <% } else { %>
        <span>Aucun bulletin à valider pour <%= monthNames[validateResult.month] %> <%= validateResult.year %>.</span>
    <% } %>
</div>
<% } %>

<% if (typeof draftResult !== 'undefined' && draftResult) { %>
<div class="bulk-summary" role="status">
    <% if (draftResult.count > 0) { %>
        <strong><%= draftResult.count %> bulletin<%= draftResult.count > 1 ? 's' : '' %> retourné<%= draftResult.count > 1 ? 's' : '' %> en brouillon pour <%= monthNames[draftResult.month] %> <%= draftResult.year %>.</strong>
    <% } else { %>
        <span>Aucun bulletin validé à retourner en brouillon pour <%= monthNames[draftResult.month] %> <%= draftResult.year %>.</span>
    <% } %>
</div>
<% } %>

<% if (closeResult) { %>
<div class="bulk-summary" role="status">
    <% if (closeResult.count > 0) { %>
        <strong><%= closeResult.count %> bulletin<%= closeResult.count > 1 ? 's' : '' %> clôturé<%= closeResult.count > 1 ? 's' : '' %> pour <%= monthNames[closeResult.month] %> <%= closeResult.year %>.</strong>
    <% } else { %>
        <span>Aucun bulletin à clôturer pour <%= monthNames[closeResult.month] %> <%= closeResult.year %> : les bulletins sont déjà clôturés ou aucun bulletin n’existe.</span>
    <% } %>
</div>
<% } %>

<!-- Period filters and bulk actions -->
<div class="card bulletin-filters">
    <section class="bulletin-filter-section" aria-labelledby="bulletin-filters-heading">
        <div class="bulletin-filter-heading">
            <span class="bulletin-filter-heading-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
            </span>
            <div class="bulletin-filter-heading-copy">
                <h2 id="bulletin-filters-heading">Filtres</h2>
                <p>Affinez la liste par catégorie<%= chantiersEnabled !== false ? ', chantier' : '' %> ou net à payer.</p>
            </div>
        </div>
        <form method="GET" action="/bulletins" id="bulletins-filter-form" class="bulletin-filter-controls">
            <input type="hidden" name="month" value="<%= month %>">
            <input type="hidden" name="year" value="<%= year %>">
            <label class="bulletin-filter-field">
                <span class="bulletin-filter-label">Matricule</span>
                <input type="search" name="matricule" class="form-input" value="<%= filters?.matricule ?? '' %>" placeholder="Rechercher un matricule" autocomplete="off">
            </label>
            <label class="bulletin-filter-field">
                <span class="bulletin-filter-label">Catégorie</span>
                <select name="categoryId" class="form-input">
                    <option value="">Toutes les catégories</option>
                    <% (categories || []).forEach(category => { %>
                        <option value="<%= category.id %>" <%= String(filters?.categoryId || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
                    <% }); %>
                </select>
            </label>
            <% if (chantiersEnabled !== false) { %>
                <label class="bulletin-filter-field">
                    <span class="bulletin-filter-label">Chantier</span>
                    <select name="chantierId" class="form-input">
                        <option value="">Tous les chantiers</option>
                        <% (chantiers || []).forEach(item => { %>
                            <option value="<%= item.id %>" <%= String(filters?.chantierId || '') === String(item.id) ? 'selected' : '' %>><%= item.nom %></option>
                        <% }); %>
                    </select>
                </label>
            <% } %>
            <label class="bulletin-filter-field">
                <span class="bulletin-filter-label">Net minimum</span>
                <span class="bulletin-money-input">
                    <input type="number" name="netMin" class="form-input" value="<%= filters?.netMin ?? '' %>" min="0" step="0.01" placeholder="0,00" inputmode="decimal">
                    <span class="bulletin-money-suffix" aria-hidden="true">DH</span>
                </span>
            </label>
            <label class="bulletin-filter-field">
                <span class="bulletin-filter-label">Net maximum</span>
                <span class="bulletin-money-input">
                    <input type="number" name="netMax" class="form-input" value="<%= filters?.netMax ?? '' %>" min="0" step="0.01" placeholder="0,00" inputmode="decimal">
                    <span class="bulletin-money-suffix" aria-hidden="true">DH</span>
                </span>
            </label>
            <div class="bulletin-filter-actions">
                <button type="submit" class="btn-primary bulletin-filter-submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                    </svg>
                    Filtrer
                </button>
                <% if (filters?.categoryId || filters?.chantierId || filters?.matricule || filters?.netMin !== '' || filters?.netMax !== '') { %>
                    <a href="/bulletins?month=<%= month %>&year=<%= year %>" class="bulletin-filter-reset">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="1 4 1 10 7 10"/>
                            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                        </svg>
                        Réinitialiser
                    </a>
                <% } %>
            </div>
        </form>
    </section>

    <section class="bulletin-filter-section bulletin-actions-section" aria-labelledby="bulletin-actions-heading">
        <div class="bulletin-filter-heading">
            <span class="bulletin-filter-heading-icon bulletin-filter-heading-icon--actions" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"/>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                </svg>
            </span>
            <div class="bulletin-filter-heading-copy">
                <h2 id="bulletin-actions-heading">Actions de traitement</h2>
                <p>Appliquez une action groupée aux bulletins de la période.</p>
            </div>
        </div>
        <div class="bulletin-filter-controls bulletin-action-controls">
            <% if (employees.some(emp => !emp.bulletin)) { %>
            <form method="POST" action="/bulletins/generate-bulk">
                <input type="hidden" name="month" value="<%= month %>">
                <input type="hidden" name="year" value="<%= year %>">
                <button type="submit" id="btn-bulk-generate" class="btn-primary bulletin-bulk-action" data-confirm="Générer les bulletins pour tous les employés actifs qui n’en ont pas encore pour <%= monthName %> <%= year %> ?" data-confirm-title="Générer les bulletins" data-confirm-label="Générer">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                    <polyline points="13 2 13 9 20 9"/>
                    <line x1="9" y1="13" x2="15" y2="13"/>
                    <line x1="9" y1="17" x2="15" y2="17"/>
                </svg>
                Traitement par liste
                </button>
            </form>
            <% } %>
            <% if (employees.some(emp => ['draft', 'generated'].includes(emp.bulletin?.status))) { %>
            <form method="POST" action="/bulletins/validate-bulk">
                <input type="hidden" name="month" value="<%= month %>">
                <input type="hidden" name="year" value="<%= year %>">
                <button type="submit" class="btn-primary validate-action bulletin-bulk-action" data-confirm="Valider les bulletins en brouillon ou générés des employés actifs pour <%= monthName %> <%= year %> ? Les bulletins validés seront verrouillés." data-confirm-title="Valider par liste" data-confirm-label="Valider">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    Valider par liste
                </button>
            </form>
            <% } %>
            <% if (employees.some(emp => emp.bulletin?.status === 'validated')) { %>
            <form method="POST" action="/bulletins/draft-bulk">
                <input type="hidden" name="month" value="<%= month %>">
                <input type="hidden" name="year" value="<%= year %>">
                <button type="submit" class="btn-primary draft-action bulletin-bulk-action" data-confirm="Retourner tous les bulletins validés de <%= monthName %> <%= year %> en brouillon ? Ils pourront à nouveau être modifiés." data-confirm-title="Retourner en brouillon en masse" data-confirm-label="Retourner en brouillon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="1 4 1 10 7 10"/>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                    </svg>
                    Retourner en brouillon en masse
                </button>
            </form>
            <% } %>
        </div>
    </section>
</div>

<!-- Employees payroll table -->
<div class="bulletins-scrollbar" id="bulletins-scrollbar" aria-label="Faire défiler les rubriques horizontalement" tabindex="0"><div></div></div>
<div class="data-table-wrapper" id="bulletins-table-wrapper">
    <table class="data-table" id="bulletins-table">
        <thead>
            <tr>
                <th>Matricule</th>
                <th class="employee-name-column">Nom et prénom</th>
                <% visibleRubriqueColumns.forEach(column => { %>
                    <th class="rubrique-column-header"><%= ['CNSS', 'AMO', 'CIMR'].includes(column.label) ? 'Retenue · ' : '' %><%= column.label %></th>
                    <% if (column.label === 'Salaire de base') { %><th>Nbr j/h</th><% } %>
                <% }); %>
                <th class="status-column">Statut bulletin</th>
                <th class="actions-column">Actions</th>
                <th class="net-column" style="font-variant-numeric: tabular-nums;">
                    <strong>Net à payer</strong>
                </th>
            </tr>
        </thead>
        <tbody>
            <% employees.forEach(function(emp) { %>
                <tr class="bulletin-row"
                    data-href="/bulletins/<%= emp.id %>?month=<%= month %>&year=<%= year %>">

                    <td class="matricule-column">
                        <span style="font-weight: 600;"><%= emp.matricule || '—' %></span>
                        <% if (!emp.actif) { %>
                            <span class="bulletin-inactive-label">Employé inactif</span>
                        <% } %>
                        <% (emp.rubriqueVisibilityInputs || []).forEach(input => { %>
                            <input type="hidden" name="<%= input.name %>" value="<%= input.value %>">
                        <% }); %>
                    </td>

                    <td class="employee-name-column">
                        <span style="font-weight: 600;"><%= emp.nomComplet %></span>
                    </td>

                    <% visibleRubriqueColumns.forEach(column => {
                        const component = (emp.bulletinComponents || []).find(item => `${item.code}|${item.label}` === column.key);
                        const primeRendementEditable = emp.actif && !emp.blocageSaisiePaie
                            && (!emp.bulletin || ['draft', 'generated'].includes(emp.bulletin.status));
                    %>
                        <td class="rubrique-column-cell" onclick="event.stopPropagation();">
                            <% if (component?.label === 'ARRONDI') { %>
                                <% if (component?.gains !== null) { %><span class="arrondi-gain">Gain <%= fmt(component?.gains) %></span><% } else if (component?.retenues !== null) { %><span class="arrondi-retenue">Retenue <%= fmt(component?.retenues) %></span><% } else { %>—<% } %>
                            <% } else if (component?.kind === 'primeRendement' && component.key === 'primeRendementInput') { %>
                                <input class="bulletin-component-input prime-rendement-input" type="number" name="primeRendementInput" value="<%= Number(component.base ?? 0).toFixed(2) %>" min="0" max="999999.99" step="0.01" required aria-label="Saisie de la prime rendement pour <%= emp.nomComplet %>" <%= primeRendementEditable ? '' : 'disabled' %>>
                                <small>Calculé : <output data-prime-rendement-amount><%= fmt(component.gains ?? 0) %></output> DH</small>
                            <% } else if (component?.kind === 'prime') { %>
                                <input form="bulletin-form-<%= emp.id %>" class="bulletin-component-input" type="number" name="primesAmounts" value="<%= component?.gains ?? 0 %>" min="0" step="0.01"><input form="bulletin-form-<%= emp.id %>" type="hidden" name="primesLabels" value="<%= component.label %>">
                            <% } else if (component?.kind === 'nimp') { %>
                                <% const componentMax = Number(component.maxAmount) > 0 ? Number(component.maxAmount).toFixed(2) : ''; %>
                                <input form="bulletin-form-<%= emp.id %>" class="nimp-amount-input bulletin-component-input" type="number" name="nimpAmounts" value="<%= Number(component?.gains ?? 0).toFixed(2) %>" min="0.01" <%= componentMax ? `max="${componentMax}"` : '' %> step="0.01" data-old-label="<%= component.label %>" data-old-amount="<%= Number(component?.gains ?? 0).toFixed(2) %>" data-max-amount="<%= componentMax %>" data-sticky="false"><input form="bulletin-form-<%= emp.id %>" type="hidden" name="nimpLabels" value="<%= component.label %>">
                            <% } else if (component?.label === "Prime d'ancienneté") { %>
                                <% if (component.rate !== null) { %><%= (Number(component.rate) * 100).toFixed(2) %> % · <% } %><%= component?.gains !== null ? fmt(component?.gains) + ' DH' : '—' %>
                            <% } else if (component?.kind === 'salary') { %>
                                <%= component?.gains !== null ? fmt(component?.gains) + ' DH' : '—' %>
                            <% } else if (['paidLeave', 'birthLeave', 'holiday', 'overtime'].includes(component?.kind)) { %>
                                <input form="bulletin-form-<%= emp.id %>" class="bulletin-component-input" type="number" name="<%= component.kind === 'paidLeave' ? 'paidLeaveDays' : component.kind === 'birthLeave' ? 'congeNaissanceDays' : component.kind === 'holiday' ? 'joursFeries' : component.key %>" value="<%= component.base ?? 0 %>" min="0" <%= ['paidLeave', 'birthLeave', 'holiday'].includes(component.kind) ? 'max="26"' : '' %> step="<%= ['paidLeave', 'birthLeave', 'holiday'].includes(component.kind) ? '1' : '0.01' %>">
                            <% } else { %>
                                <%= component?.gains !== null ? fmt(component?.gains) + ' DH' : component?.retenues !== null ? fmt(component?.retenues) + ' DH' : '—' %>
                            <% } %>
                        </td>
                        <% if (component?.kind === 'salary') { %>
                            <td>
                                <% if (emp.bulletin && emp.actif && !emp.blocageSaisiePaie && ['draft', 'generated'].includes(emp.bulletin.status)) { %>
                                    <form class="worked-days-form" action="/bulletins/<%= emp.id %>/worked-days" method="POST">
                                        <input type="hidden" name="month" value="<%= month %>">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <div class="worked-days-controls">
                                            <% if (emp.workingTimeMode === 'HOURS') { %>
                                                <input class="form-input" type="number" name="workedHours" min="0" max="<%= emp.standardMonthlyHours %>" step="0.01" required value="<%= emp.bulletin.workedHours %>" aria-label="Heures travaillées de <%= emp.nomComplet %>">
                                                <small>h</small>
                                            <% } else { %>
                                                <input class="form-input" type="number" name="workedDays" min="0" max="<%= emp.standardMonthlyDays %>" step="0.01" required value="<%= emp.bulletin.workedDays %>" aria-label="Jours travaillés de <%= emp.nomComplet %>">
                                                <small>j</small>
                                            <% } %>
                                        </div>
                                        <span class="worked-days-message" role="status" aria-live="polite"></span>
                                    </form>
                                <% } else if (emp.bulletin) { %>
                                    <%= emp.workingTimeMode === 'HOURS' ? `${Number(emp.bulletin.workedHours).toFixed(2)} h` : `${Number(emp.bulletin.workedDays).toFixed(2)} j` %>
                                <% } else { %>—<% } %>
                            </td>
                        <% } %>
                    <% }); %>

                    <td class="status-column">
                        <% if (emp.bulletinStatus === 'blocked' || emp.blocageSaisiePaie || !emp.actif) { %>
                            <span class="badge badge-blocked"><%= !emp.actif ? 'Inactif · Bloqué' : 'Bloqué' %></span>
                        <% } else if (emp.bulletinStatus === 'none') { %>
                            <span class="badge badge-none">Aucun</span>
                        <% } else if (emp.bulletinStatus === 'draft' || emp.bulletinStatus === 'generated') { %>
                            <span class="badge badge-draft">Brouillon</span>
                        <% } else if (emp.bulletinStatus === 'validated') { %>
                            <span class="badge badge-actif">Validé</span>
                        <% } else if (emp.bulletinStatus === 'closed') { %>
                            <span class="badge badge-actif">Clôturé</span>
                        <% } else if (emp.bulletinStatus === 'error') { %>
                            <span class="badge badge-error">Erreur</span>
                        <% } %>
                    </td>

                    <td class="actions-column" onclick="event.stopPropagation();">
                        <div class="table-actions">
                            <% if (!emp.bulletin && emp.actif || emp.bulletinStatus === 'error' && emp.actif) { %>
                                <form method="POST" action="/bulletins/<%= emp.id %>/generate" style="display:inline;">
                                    <input type="hidden" name="month" value="<%= month %>">
                                    <input type="hidden" name="year" value="<%= year %>">
                                    <button type="submit" class="btn-primary" style="padding: 7px 14px; font-size: 13px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polygon points="5 3 19 12 5 21 5 3"/>
                                        </svg>
                                        Générer
                                    </button>
                                </form>
                            <% } else { %>
                                <a href="/bulletins/<%= emp.id %>?month=<%= month %>&year=<%= year %>"
                                    class="table-link">Voir bulletin →</a>
                            <% } %>
                            <% if (['draft', 'generated'].includes(emp.bulletinStatus)) { %>
                                <form method="POST" action="/bulletins/<%= emp.id %>/validate" style="display:inline;">
                                    <input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="year" value="<%= year %>">
                                    <button type="submit" class="btn-primary" data-confirm="Valider le bulletin de <%= emp.nomComplet %> ? Il sera verrouillé et ne pourra plus être modifié sans retour en brouillon." data-confirm-title="Valider le bulletin" data-confirm-label="Valider" style="padding: 7px 12px; font-size: 12px;">Valider</button>
                                </form>
                            <% } else if (emp.bulletinStatus === 'validated') { %>
                                <form method="POST" action="/bulletins/<%= emp.id %>/draft" style="display:inline;">
                                    <input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="year" value="<%= year %>">
                                    <button type="submit" class="btn-secondary" data-confirm="Retourner le bulletin de <%= emp.nomComplet %> en brouillon ? Il pourra à nouveau être modifié." data-confirm-title="Retourner en brouillon" data-confirm-label="Retourner en brouillon" style="padding: 7px 12px; font-size: 12px;">Retourner en brouillon</button>
                                </form>
                            <% } %>
                            <% if (!emp.bulletin && emp.actif) { %>
                                <a href="/bulletins/<%= emp.id %>?month=<%= month %>&year=<%= year %>" class="table-link">Voir →</a>
                            <% } %>
                            <% if (emp.blocageSaisiePaie) { %>
                                <button type="button" class="btn-mask mask-bulletin-button"
                                    data-employee="<%= emp.nomComplet %>"
                                    data-action="/bulletins/<%= emp.id %>/mask">Masquer</button>
                            <% } %>
                        </div>
                    </td>

                    <td class="net-column" data-payroll-net style="font-variant-numeric: tabular-nums;">
                        <% if (emp.bulletin && emp.bulletin.netAPayer !== undefined && emp.bulletinStatus !== 'error') { %>
                            <strong data-payroll-net-value><%= fmt(emp.bulletin.netAPayer) %> DH</strong>
                        <% } else { %>
                            <span data-payroll-net-value style="color: var(--color-text-subtle);">—</span>
                        <% } %>
                        <small class="worked-days-message" data-payroll-status role="status" aria-live="polite"></small>
                    </td>

                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

