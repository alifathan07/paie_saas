<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuration — Enmae Paie</title>
    <link rel="stylesheet" href="/css/custom.css?v=20261101-sticky-columns">
    <link rel="stylesheet" href="/css/auth-register.css?v=20261110">
    <style>.setup-skip{border:0;background:none;color:#71809a;font:inherit;font-size:12px;cursor:pointer;padding:8px 0}.setup-skip:hover{color:#3158c9}</style>
    <style>.setup-page{min-height:100vh;background:rgba(23,38,75,.08);display:flex;align-items:center;justify-content:center;padding:24px}.setup-modal{width:min(760px,100%);max-height:calc(100vh - 48px);overflow:auto;background:#fff;border:1px solid #e1e7f0;border-radius:20px;box-shadow:0 25px 80px rgba(23,38,75,.2);padding:38px}.setup-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:26px}.setup-header h1{margin:7px 0 8px;color:#17264b;font-size:28px;letter-spacing:-.8px}.setup-header p{margin:0;color:#71809a;font-size:14px;line-height:1.6}.setup-badge{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:#edf2ff;color:#3158c9;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px}.setup-badge:before{content:"";width:7px;height:7px;border-radius:50%;background:#3158c9}.setup-error{padding:12px 14px;margin-bottom:20px;border:1px solid #f3c2c2;border-radius:10px;background:#fff4f4;color:#b4232d;font-size:13px}.setup-form{display:grid;gap:18px}.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.setup-field{display:grid;gap:7px}.setup-field.full{grid-column:1/-1}.setup-field label{color:#33405a;font-size:13px;font-weight:700}.setup-field input{width:100%;box-sizing:border-box;padding:13px 14px;border:1px solid #dce2ec;border-radius:10px;outline:none;background:#fbfcfe;color:#172033;font:inherit;font-size:14px}.setup-field input:focus{border-color:#4f6ed0;background:#fff;box-shadow:0 0 0 4px rgba(79,110,208,.12)}.setup-required{color:#d24c5d}.setup-footer{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:8px;padding-top:22px;border-top:1px solid #edf0f5}.setup-submit{border:0;border-radius:10px;padding:13px 20px;background:#3158c9;color:#fff;font:inherit;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 8px 18px rgba(49,88,201,.2)}.setup-help{color:#8994a8;font-size:12px;line-height:1.5}@media(max-width:620px){.setup-page{padding:12px}.setup-modal{padding:25px 20px;border-radius:16px}.setup-header h1{font-size:24px}.setup-grid{grid-template-columns:1fr}.setup-field.full{grid-column:auto}.setup-footer{display:block}.setup-submit{width:100%;margin-top:16px}}</style>
</head>
<body class="setup-page">
    <main class="setup-modal" role="dialog" aria-modal="true" aria-labelledby="setup-title">
        <div class="setup-brand"><img src="/logo.png" alt="Enmae Solutions"></div>
        <div class="setup-header"><div><div class="signup-eyebrow" style="color:#5270cc">Première configuration</div><h1 id="setup-title">Complétez votre entreprise</h1><p>Ces informations sont nécessaires pour générer correctement vos bulletins, PDF et déclarations.</p></div><span class="setup-badge">Obligatoire</span></div>
        <% if (error) { %><div class="setup-error" role="alert"><%= error %></div><% } %>
        <form class="setup-form" action="/auth/company-setup" method="POST">
            <div class="setup-grid">
                <div class="setup-field full"><label for="name">Raison sociale <span class="setup-required">*</span></label><input id="name" name="name" maxlength="191" value="<%= form.name %>" required></div>
                <div class="setup-field full"><label for="adresse">Adresse <span class="setup-required">*</span></label><input id="adresse" name="adresse" maxlength="191" value="<%= form.adresse %>" placeholder="Adresse complète" required></div>
                <div class="setup-field"><label for="ville">Ville <span class="setup-required">*</span></label><input id="ville" name="ville" maxlength="191" value="<%= form.ville %>" placeholder="Casablanca" required></div>
                <div class="setup-field"><label for="ifNumber">Identifiant fiscal (IF) <span class="setup-required">*</span></label><input id="ifNumber" name="ifNumber" maxlength="191" value="<%= form.ifNumber %>" required></div>
                <div class="setup-field"><label for="numeroAffiliationCnss">N° affiliation CNSS <span class="setup-required">*</span></label><input id="numeroAffiliationCnss" name="numeroAffiliationCnss" maxlength="191" value="<%= form.numeroAffiliationCnss %>" required></div>
                <div class="setup-field"><label for="smig">SMIG mensuel (DH) <span class="setup-required">*</span></label><input id="smig" name="smig" type="number" min="0.01" step="0.01" value="<%= form.smig %>" required></div>
                <div class="setup-field"><label for="ice">ICE <span style="color:#8994a8;font-weight:400">(optionnel)</span></label><input id="ice" name="ice" maxlength="191" value="<%= form.ice %>"></div>
                <div class="setup-field"><label for="rc">Registre de commerce <span style="color:#8994a8;font-weight:400">(optionnel)</span></label><input id="rc" name="rc" maxlength="191" value="<%= form.rc %>"></div>
                <div class="setup-field full"><label for="numeroAssurance">N° assurance <span style="color:#8994a8;font-weight:400">(optionnel)</span></label><input id="numeroAssurance" name="numeroAssurance" maxlength="191" value="<%= form.numeroAssurance %>"></div>
            </div>
            <div class="setup-footer"><button class="setup-skip" type="submit" name="skip" value="1" formnovalidate>Passer pour le moment</button><span class="setup-help"><span class="setup-required">*</span> Champs obligatoires pour les documents de paie.</span><button class="setup-submit" type="submit">Enregistrer et accéder à mon espace</button></div>
        </form>
    </main>
</body>
</html>
