<%- include('../partials/header') %>
<div class="page-header"><div class="header-title-area"><h1 class="page-title"><%= account.name %></h1><p class="page-subtitle"><%= account.email %> · Utilisateur #<%= account.id %></p></div><div class="header-actions"><a href="/admin/users" class="btn-secondary">Retour aux utilisateurs</a></div></div>
<div class="admin-detail-grid">
<section class="admin-section-card"><h2>Compte</h2><p><strong>Statut :</strong> <% if (account.isBlocked) { %><span class="badge badge-blocked">Bloqué</span><% } else { %><span class="badge badge-actif">Actif</span><% } %></p><p><strong>Rôle :</strong> <%= account.isAdmin ? 'Administrateur' : 'Client' %></p><p><strong>Sociétés :</strong> <%= account.userCompanies.length %> / <%= account.maxCompanies === 0 ? 'illimité' : account.maxCompanies %></p><div class="table-actions"><% if (!account.isAdmin) { %><% if (account.isBlocked) { %><form method="POST" action="/admin/clients/<%= account.id %>/unblock"><button class="btn-primary">Débloquer</button></form><% } else { %><form class="block-user-form" method="POST" action="/admin/clients/<%= account.id %>/block" data-default-reason="Paiement en attente"><input type="hidden" name="reason" value="Paiement en attente"><button class="btn-secondary">Bloquer</button></form><% } %><% } %></div></section>
<section class="admin-section-card"><h2>Limite de sociétés</h2><form method="POST" action="/admin/clients/<%= account.id %>/billing" class="inline-form"><input class="form-input" type="number" name="maxCompanies" min="0" max="1000" value="<%= account.maxCompanies %>" required><button class="btn-primary">Enregistrer</button></form><p class="muted">0 signifie illimité, selon la convention actuelle de l'application.</p></section>
</div>
<section class="admin-section-card"><div class="section-heading"><h2>Sociétés de l'utilisateur</h2></div><div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Société</th><th>ID</th><th>Support</th></tr></thead><tbody><% account.userCompanies.forEach(membership => { %><tr><td><a href="/admin/companies/<%= membership.company.id %>"><%= membership.company.name %></a></td><td><%= membership.company.id %></td><td><form method="POST" action="/admin/clients/<%= account.id %>/mode"><input type="hidden" name="companyId" value="<%= membership.companyId %>"><button class="btn-primary">Entrer en support</button></form></td></tr><% }) %><% if (!account.userCompanies.length) { %><tr><td colspan="3">Aucune société.</td></tr><% } %></tbody></table></div><form method="POST" action="/admin/clients/<%= account.id %>/companies" class="inline-form" style="margin-top:16px"><input class="form-input" name="name" required placeholder="Nom de la nouvelle société"><button class="btn-secondary">Créer une société</button></form></section>
<section class="admin-section-card"><h2>Activité ciblée</h2><div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Date</th><th>Action</th><th>Acteur</th><th>Société</th></tr></thead><tbody><% activity.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('fr-FR') %></td><td><%= log.action %></td><td><%= log.actor.name %></td><td><%= log.company?.name || '—' %></td></tr><% }) %><% if (!activity.length) { %><tr><td colspan="4">Aucune activité.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
