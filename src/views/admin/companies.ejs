<%- include('../partials/header') %>
<div class="page-header"><div class="header-title-area"><h1 class="page-title">Sociétés</h1><p class="page-subtitle">Visibilité globale avec propriétaire et effectif.</p></div><div class="header-actions"><a href="/admin/users" class="btn-secondary">Utilisateurs</a><a href="/admin" class="btn-secondary">Dashboard</a></div></div>
<form method="GET" action="/admin/companies" class="admin-filter"><input class="form-input" name="q" value="<%= q %>" placeholder="Rechercher par nom ou ID"><button class="btn-primary">Rechercher</button></form>
<div class="data-table-wrapper"><table class="data-table"><thead><tr><th>ID</th><th>Société</th><th>Propriétaire</th><th>Employés</th><th>Rapports</th><th>Créée le</th><th></th></tr></thead><tbody><% companies.forEach(company => { const owner = company.userCompanies[0]?.user; %><tr><td><%= company.id %></td><td><strong><%= company.name %></strong></td><td><% if (owner) { %><a href="/admin/users/<%= owner.id %>"><%= owner.name %></a><br><small><%= owner.email %></small><% } else { %>—<% } %></td><td><%= company._count.employees %></td><td><%= company._count.reports %></td><td><%= new Date(company.createdAt).toLocaleDateString('fr-FR') %></td><td><a class="btn-secondary" href="/admin/companies/<%= company.id %>">Détails</a></td></tr><% }) %><% if (!companies.length) { %><tr><td colspan="7">Aucune société.</td></tr><% } %></tbody></table></div>
<%- include('../partials/footer') %>
