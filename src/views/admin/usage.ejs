<%- include('../partials/header') %>
<div class="page-header"><div class="header-title-area"><h1 class="page-title">Usage & limites</h1><p class="page-subtitle">Vue simple des sociétés utilisées et des limites de comptes.</p></div><div class="header-actions"><a href="/admin/users" class="btn-secondary">Utilisateurs</a></div></div>
<div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Utilisateur</th><th>Sociétés utilisées</th><th>Maximum</th><th>Utilisation</th><th>État</th></tr></thead><tbody><% users.forEach(account => { const count = account.userCompanies.length; const unlimited = account.maxCompanies === 0; const percent = unlimited ? 0 : Math.min(100, Math.round((count / account.maxCompanies) * 100)); %><tr><td><a href="/admin/users/<%= account.id %>"><%= account.name %></a><br><small><%= account.email %></small></td><td><%= count %></td><td><%= unlimited ? 'Illimité' : account.maxCompanies %></td><td><% if (unlimited) { %><span class="badge">Illimité</span><% } else { %><div class="usage-bar"><span style="width:<%= percent %>%"></span></div><small><%= percent %>%</small><% } %></td><td><%= account.isBlocked ? 'Bloqué' : 'Actif' %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
