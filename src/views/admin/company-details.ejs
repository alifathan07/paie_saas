<%- include('../partials/header') %>
<% const owner = company.userCompanies[0]?.user; %>
<div class="page-header"><div class="header-title-area"><h1 class="page-title"><%= company.name %></h1><p class="page-subtitle">Société #<%= company.id %> · créée le <%= new Date(company.createdAt).toLocaleDateString('fr-FR') %></p></div><div class="header-actions"><a href="/admin/companies" class="btn-secondary">Toutes les sociétés</a></div></div>
<div class="dashboard-grid"><div class="stat-card"><span>Employés</span><strong><%= company._count.employees %></strong></div><div class="stat-card"><span>Bulletins enregistrés</span><strong><%= payslipCount %></strong></div><div class="stat-card"><span>Propriétaire</span><strong><%= owner?.name || '—' %></strong></div></div>
<section class="admin-section-card"><h2>Propriétaire</h2><% if (owner) { %><p><a href="/admin/users/<%= owner.id %>"><strong><%= owner.name %></strong></a> · <%= owner.email %></p><p>Statut : <%= owner.isBlocked ? 'Bloqué' : 'Actif' %></p><% if (!owner.isAdmin) { %><form method="POST" action="/admin/clients/<%= owner.id %>/mode" style="margin-top:12px"><input type="hidden" name="companyId" value="<%= company.id %>"><button class="btn-primary">Entrer en support</button></form><% } %><% } else { %><p>Propriétaire introuvable.</p><% } %></section>
<section class="admin-section-card"><h2>Employés</h2><div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Nom</th><th>Matricule</th><th>Statut</th><th>Créé le</th></tr></thead><tbody><% company.employees.forEach(employee => { %><tr><td><%= employee.nomComplet %></td><td><%= employee.matricule %></td><td><%= employee.actif ? 'Actif' : 'Inactif' %></td><td><%= new Date(employee.createdAt).toLocaleDateString('fr-FR') %></td></tr><% }) %><% if (!company.employees.length) { %><tr><td colspan="4">Aucun employé.</td></tr><% } %></tbody></table></div></section>
<section class="admin-section-card"><h2>Activité paie récente</h2><div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Employé</th><th>Période</th><th>Statut</th></tr></thead><tbody><% recentPayslips.forEach(payslip => { %><tr><td><%= payslip.employee.nomComplet %></td><td><%= payslip.month %>/<%= payslip.year %></td><td><%= payslip.status %></td></tr><% }) %><% if (!recentPayslips.length) { %><tr><td colspan="3">Aucun bulletin.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
