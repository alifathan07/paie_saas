<%- include('../partials/header') %>
<div class="page-header"><div class="header-title-area"><h1 class="page-title">Audit Logs</h1><p class="page-subtitle">Historique des actions sensibles de l'administration.</p></div><div class="header-actions"><a href="/admin" class="btn-secondary">Dashboard</a></div></div>
<form method="GET" action="/admin/audit-logs" class="admin-filter"><select class="form-input" name="action"><option value="">Toutes les actions</option><% actions.forEach(item => { %><option value="<%= item %>" <%= action === item ? 'selected' : '' %>><%= item %></option><% }) %></select><button class="btn-primary">Filtrer</button></form>
<div class="data-table-wrapper"><table class="data-table"><thead><tr><th>Date</th><th>Action</th><th>Acteur</th><th>Cible</th><th>Société</th><th>IP</th></tr></thead><tbody><% logs.forEach(log => { %><tr><td><%= new Date(log.createdAt).toLocaleString('fr-FR') %></td><td><span class="badge"><%= log.action %></span></td><td><%= log.actor.name %><br><small><%= log.actor.email %></small></td><td><%= log.targetType %>#<%= log.targetId || '—' %></td><td><%= log.company?.name || '—' %></td><td><%= log.ipAddress || '—' %></td></tr><% }) %><% if (!logs.length) { %><tr><td colspan="6">Aucun événement.</td></tr><% } %></tbody></table></div>
<%- include('../partials/footer') %>
