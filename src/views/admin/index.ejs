<%- include('../partials/header') %>
<div class="admin-hero">
    <div><div class="eyebrow">CENTRE DE CONTRÔLE</div><h1>Bonjour, <%= user?.name?.split(' ')[0] || 'Admin' %> <span class="wave">✦</span></h1><p>Voici ce qui se passe dans votre plateforme aujourd’hui.</p></div>
    <div class="admin-hero-actions"><span class="admin-live-dot"><i></i> Système opérationnel</span><a href="/admin/clients" class="admin-primary-action">Gérer les clients <span>→</span></a></div>
</div>
<div class="admin-kpi-grid">
    <div class="admin-kpi admin-kpi-blue"><span class="kpi-icon">◉</span><div><small>Clients actifs</small><strong><%= stats.activeUsers %></strong><em>sur <%= stats.totalUsers %> comptes</em></div></div>
    <div class="admin-kpi admin-kpi-violet"><span class="kpi-icon">▦</span><div><small>Sociétés suivies</small><strong><%= stats.companyCount %></strong><em><%= stats.employeeCount %> employés au total</em></div></div>
    <div class="admin-kpi admin-kpi-amber"><span class="kpi-icon">!</span><div><small>À traiter</small><strong><%= stats.openReports %></strong><em>rapport<%= stats.openReports === 1 ? '' : 's' %> en attente</em></div></div>
    <div class="admin-kpi admin-kpi-green"><span class="kpi-icon">✓</span><div><small>Résolus</small><strong><%= stats.solvedReports %></strong><em>rapports terminés</em></div></div>
</div>
<div class="admin-dashboard-grid">
    <section class="admin-modern-card admin-chart-card"><div class="admin-card-heading"><div><h2>Activité des sociétés</h2><p>Les espaces qui ont le plus d’employés</p></div><a href="/admin/companies">Voir tout →</a></div><div class="simple-bars"><% const maxEmployees = Math.max(...(companyOverview || []).map(c => c._count.employees), 1); %><% if (!companyOverview?.length) { %><p class="muted">Aucune société pour le moment.</p><% } %><% (companyOverview || []).forEach((company, index) => { %><div class="bar-row"><span class="bar-label"><b><%= company.name.slice(0, 22) %></b><small><%= company._count.userCompanies %> client<%= company._count.userCompanies === 1 ? '' : 's' %></small></span><div class="bar-track"><i style="width:<%= Math.max(8, Math.round(company._count.employees / maxEmployees * 100)) %>%;background:<%= ['#5b6ee1','#7c5ce7','#24b39b','#f2a93b','#ec6b83','#38a8d9'][index % 6] %>"></i></div><strong><%= company._count.employees %></strong></div><% }) %></div></section>
    <section class="admin-modern-card admin-focus-card"><div class="admin-card-heading"><div><h2>À retenir</h2><p>Une lecture simple de la situation</p></div></div><div class="focus-list"><div><span class="focus-bullet blue">●</span><p><strong><%= stats.activeUsers %> clients actifs</strong><br><small>peuvent accéder à leur espace.</small></p></div><div><span class="focus-bullet amber">!</span><p><strong><%= stats.openReports %> demande<%= stats.openReports === 1 ? '' : 's' %> à regarder</strong><br><small>ouvrez les rapports pour aider rapidement.</small></p></div><div><span class="focus-bullet green">✓</span><p><strong><%= stats.companyCount %> société<%= stats.companyCount === 1 ? '' : 's' %> configurée<%= stats.companyCount === 1 ? '' : 's' %></strong><br><small><%= stats.employeeCount %> employés enregistrés.</small></p></div></div><a class="focus-link" href="/admin/reports">Ouvrir le centre de suivi →</a></section>
</div>
<div class="admin-lower-grid">
    <section class="admin-modern-card"><div class="admin-card-heading"><div><h2>Derniers clients</h2><p>Les comptes ajoutés récemment</p></div><a href="/admin/clients">Tous les clients →</a></div><div class="admin-client-list"><% if (!recentUsers?.length) { %><p class="muted">Aucun client pour le moment.</p><% } %><% (recentUsers || []).forEach(client => { %><a href="/admin/users/<%= client.id %>" class="admin-client-row"><span class="client-avatar"><%= client.name.split(' ').map(n => n[0]).join('').slice(0,2).toUpperCase() %></span><span><b><%= client.name %></b><small><%= client.email %></small></span><em class="client-status <%= client.isBlocked ? 'blocked' : '' %>"><%= client.isBlocked ? 'Bloqué' : 'Actif' %></em><span class="row-arrow">→</span></a><% }) %></div></section>
    <section class="admin-modern-card quick-actions-card"><div class="admin-card-heading"><div><h2>Accès rapide</h2><p>Les actions que vous utilisez souvent</p></div></div><div class="quick-action-grid"><a href="/admin/users/new"><span>＋</span><b>Nouveau client</b><small>Créer un compte</small></a><a href="/admin/companies"><span>▦</span><b>Voir les sociétés</b><small>Explorer les espaces</small></a><a href="/admin/reports"><span>◌</span><b>Lire les rapports</b><small>Répondre aux demandes</small></a><a href="/admin/audit-logs"><span>↗</span><b>Voir l’activité</b><small>Suivre les changements</small></a></div></section>
</div>
<section class="admin-modern-card admin-activity-card"><div class="admin-card-heading"><div><h2>Activité récente</h2><p>Les dernières actions faites dans le système</p></div><a href="/admin/audit-logs">Journal complet →</a></div><% if (!recentActivity.length) { %><p class="muted">Aucune activité enregistrée.</p><% } else { %><div class="activity-feed"><% recentActivity.slice(0, 5).forEach(log => { %><div class="activity-row"><span class="activity-dot"></span><span><b><%= log.actor.name %></b> · <%= log.action.replaceAll('_', ' ').toLowerCase() %><small><%= new Date(log.createdAt).toLocaleString('fr-FR') %><%= log.company?.name ? ` · ${log.company.name}` : '' %></small></span></div><% }) %></div><% } %></section>
<%- include('../partials/footer') %>
